<!-- pages/admin/admin.wxml -->
<page-meta page-style="{{themePageStyle}}"></page-meta>
<view wx:if="{{accessAllowed}}" class="page-container {{themeClass}}">

  <!-- Tab 切换 -->
  <view class="admin-tabs">
    <view class="admin-tab {{adminTab === 'users' ? 'active' : ''}}" bindtap="switchTab" data-tab="users">用户管理</view>
    <view class="admin-tab {{adminTab === 'rules' ? 'active' : ''}}" bindtap="switchTab" data-tab="rules">积分规则</view>
    <view class="admin-tab {{adminTab === 'cleanup' ? 'active' : ''}}" bindtap="switchTab" data-tab="cleanup">数据清理</view>
  </view>

  <!-- ========== 用户管理 ========== -->
  <view wx:if="{{adminTab === 'users'}}">
    <view wx:for="{{userList}}" wx:key="id" class="user-edit-card">
      <text class="ue-index">用户 #{{index + 1}}</text>
      <view class="ue-row">
        <input class="ue-input" placeholder="名字" value="{{item.editName}}" bindinput="onUserName" data-index="{{index}}" />
        <picker range="{{roleOptions}}" value="{{item.roleIdx}}" bindchange="onUserRole" data-index="{{index}}">
          <view class="ue-picker">{{item.roleName}}</view>
        </picker>
      </view>
      <view class="ue-row skin-row" wx:if="{{item.roleIdx === 2}}">
        <text class="ue-label">积分卡皮肤</text>
        <picker range="{{skinOptions}}" value="{{item.skinIdx}}" bindchange="onKidSkin" data-index="{{index}}">
          <view class="ue-picker skin-picker">{{skinOptions[item.skinIdx]}}</view>
        </picker>
        <text class="skin-local-hint">仅保存在当前设备</text>
      </view>
      <view class="ue-row">
        <text class="ue-label">密码</text>
        <input class="ue-input ue-pwd" password="{{true}}" placeholder="留空不改" value="{{item.editPwd}}" bindinput="onUserPwd" data-index="{{index}}" />
        <button class="btn btn-primary btn-xs" bindtap="saveUser" data-index="{{index}}">保存</button>
        <button class="btn btn-xs btn-del" bindtap="deleteUser" data-index="{{index}}">✕</button>
      </view>
    </view>

    <!-- 添加新用户 -->
    <view class="add-section">
      <text class="add-title">添加新用户</text>
      <view class="add-row">
        <input class="add-input" placeholder="ID(拼音)" value="{{newUid}}" bindinput="onNewUid" />
        <input class="add-input" placeholder="显示名" value="{{newName}}" bindinput="onNewName" />
        <input class="add-input" password="{{true}}" placeholder="密码" value="{{newPwd}}" bindinput="onNewPwd" />
        <picker range="{{roleOptions}}" value="{{newRoleIdx}}" bindchange="onNewRole">
          <view class="ue-picker add-picker">{{newRoleName}}</view>
        </picker>
      </view>
      <button class="btn btn-primary btn-sm add-btn" bindtap="addUser">添加</button>
    </view>
  </view>

  <!-- ========== 积分规则 ========== -->
  <view wx:if="{{adminTab === 'rules'}}" class="rules-admin">
    <view class="rules-overview-card">
      <view class="rules-overview-head">
        <view>
          <text class="rules-eyebrow">家庭规则工作台</text>
          <text class="rules-overview-title">一次只整理一类规则</text>
        </view>
        <ui-icon name="clipboard" size="54" theme="{{iconTheme}}" />
      </view>
      <view class="rules-counts">
        <text>鼓励 {{ruleStats.reward}} 条</text>
        <text>提醒 {{ruleStats.punish}} 条</text>
        <text>约定 {{ruleStats.special}} 条</text>
      </view>
      <text class="rules-overview-tip">先展开分类，再点单条规则编辑；支持模板、复制、移动与排序，所有修改会自动暂存到本机。</text>
      <text wx:if="{{draftRestored || draftSavedAt}}" class="rules-draft-status">{{draftRestored ? '已恢复本地草稿' : '草稿已自动保存'}}{{draftSavedAt ? ' · ' + draftSavedAt : ''}}</text>
    </view>

    <view class="rule-type-tabs">
      <view class="rule-type-tab reward {{ruleType === 'reward' ? 'active' : ''}}" bindtap="switchRuleType" data-type="reward">
        <ui-icon name="trend-up" size="30" theme="{{iconTheme}}" />
        <text>鼓励加分</text>
        <text class="rule-type-count">{{ruleStats.reward}}</text>
      </view>
      <view class="rule-type-tab punish {{ruleType === 'punish' ? 'active' : ''}}" bindtap="switchRuleType" data-type="punish">
        <ui-icon name="warning" size="30" theme="{{iconTheme}}" />
        <text>护糖提醒</text>
        <text class="rule-type-count">{{ruleStats.punish}}</text>
      </view>
      <view class="rule-type-tab special {{ruleType === 'special' ? 'active' : ''}}" bindtap="switchRuleType" data-type="special">
        <ui-icon name="family-heart" size="30" theme="{{iconTheme}}" />
        <text>家庭约定</text>
        <text class="rule-type-count">{{ruleStats.special}}</text>
      </view>
    </view>

    <view wx:if="{{ruleValidationMessage}}" class="rule-validation-banner">
      <ui-icon name="warning" size="28" theme="{{iconTheme}}" />
      <text>{{ruleValidationMessage}}</text>
      <button wx:if="{{ruleConflict}}" class="conflict-load-btn" bindtap="loadLatestRules">加载最新</button>
    </view>

    <block wx:if="{{ruleType === 'reward' || ruleType === 'punish'}}">
      <view wx:if="{{ruleType === 'reward' ? editRules.reward.length === 0 : editRules.punish.length === 0}}" class="rule-empty-state">
        <ui-icon name="spark" size="64" theme="{{iconTheme}}" />
        <text class="rule-empty-title">这一类还没有规则</text>
        <text class="rule-empty-copy">先新建一个分类，再添加容易理解的小规则。</text>
      </view>

      <view
        wx:for="{{ruleType === 'reward' ? editRules.reward : editRules.punish}}"
        wx:key="_uiKey"
        wx:for-item="cat"
        wx:for-index="ci"
        class="rule-category-card {{ruleType}} {{expandedRuleCategory === cat._uiKey ? 'expanded' : ''}}"
      >
        <view class="rule-category-summary" bindtap="toggleRuleCategory" data-key="{{cat._uiKey}}">
          <view class="rule-category-icon">
            <ui-icon name="{{ruleType === 'reward' ? 'trend-up' : 'warning'}}" size="34" theme="{{iconTheme}}" />
          </view>
          <view class="rule-category-copy">
            <view class="rule-category-title-row">
              <text class="rule-category-title">{{cat.category || '未命名分类'}}</text>
              <text class="rule-category-count">{{cat._uiItemCount}} 条</text>
            </view>
            <text class="rule-category-preview">{{cat._uiPreview || '展开后添加第一条规则'}}</text>
          </view>
          <text class="rule-category-arrow">{{expandedRuleCategory === cat._uiKey ? '收起⌃' : '展开⌄'}}</text>
        </view>

        <view wx:if="{{expandedRuleCategory === cat._uiKey}}" class="rule-category-body">
          <view class="category-edit-row">
            <view class="category-name-field">
              <text class="compact-label">分类名称</text>
              <input
                class="compact-input"
                maxlength="{{30}}"
                value="{{cat.category}}"
                placeholder="例如：学习习惯"
                bindinput="onCategoryName"
                data-type="{{ruleType}}"
                data-ci="{{ci}}"
              />
            </view>
            <button class="category-delete-btn" bindtap="delRCategory" data-type="{{ruleType}}" data-ci="{{ci}}">删除分类</button>
          </view>

          <view class="category-tools">
            <button disabled="{{!cat._uiCanMoveUp}}" catchtap="moveCategory" data-type="{{ruleType}}" data-ci="{{ci}}" data-direction="-1">上移</button>
            <button disabled="{{!cat._uiCanMoveDown}}" catchtap="moveCategory" data-type="{{ruleType}}" data-ci="{{ci}}" data-direction="1">下移</button>
            <button catchtap="copyCategory" data-type="{{ruleType}}" data-ci="{{ci}}">复制分类</button>
          </view>

          <view wx:if="{{cat.items.length === 0}}" class="category-items-empty">这个分类还没有规则</view>
          <view
            wx:for="{{cat.items}}"
            wx:key="_uiKey"
            wx:for-item="ruleItem"
            wx:for-index="ii"
            class="rule-summary-row"
          >
            <view class="rule-summary-copy" bindtap="openRuleEditor" data-type="{{ruleType}}" data-ci="{{ci}}" data-ii="{{ii}}">
              <text class="rule-summary-name">{{ruleItem.editLabel || '未命名规则'}}</text>
              <text class="rule-summary-meta">{{ruleItem.editUnit || '按每次计算'}}{{ruleItem.editHint ? ' · ' + ruleItem.editHint : ''}}</text>
            </view>
            <view class="rule-row-main" bindtap="openRuleEditor" data-type="{{ruleType}}" data-ci="{{ci}}" data-ii="{{ii}}">
              <text class="rule-summary-score">{{ruleItem._uiScoreText}}</text>
              <text class="rule-summary-chevron">›</text>
            </view>
            <view class="rule-row-tools">
              <button disabled="{{!ruleItem._uiCanMoveUp}}" catchtap="moveRule" data-type="{{ruleType}}" data-ci="{{ci}}" data-ii="{{ii}}" data-direction="-1">↑</button>
              <button disabled="{{!ruleItem._uiCanMoveDown}}" catchtap="moveRule" data-type="{{ruleType}}" data-ci="{{ci}}" data-ii="{{ii}}" data-direction="1">↓</button>
              <button catchtap="copyRule" data-type="{{ruleType}}" data-ci="{{ci}}" data-ii="{{ii}}">复制</button>
              <picker catchtap="noop" range="{{ruleType === 'reward' ? editRules.reward : editRules.punish}}" range-key="category" value="{{ci}}" bindchange="moveRuleToCategory" data-type="{{ruleType}}" data-ci="{{ci}}" data-ii="{{ii}}">
                <view class="rule-move-picker">移动</view>
              </picker>
            </view>
          </view>

          <view class="rule-template-shelf">
            <text class="template-title">从模板预填</text>
            <view class="template-grid">
              <button wx:for="{{ruleTemplates}}" wx:key="id" wx:for-item="template" catchtap="useRuleTemplate" data-template="{{template.id}}" data-type="{{ruleType}}" data-ci="{{ci}}">{{template.name}}</button>
            </view>
            <text class="template-tip">模板只预填表单，点“完成”后才加入本地草稿。</text>
          </view>
          <button class="add-rule-row" bindtap="addRItem" data-type="{{ruleType}}" data-ci="{{ci}}">＋ 添加一条{{ruleType === 'reward' ? '鼓励规则' : '护糖提醒'}}</button>
        </view>
      </view>

      <view class="new-category-card">
        <text class="new-category-title">新建{{ruleType === 'reward' ? '鼓励' : '提醒'}}分类</text>
        <view class="new-category-row" wx:if="{{ruleType === 'reward'}}">
          <input class="new-category-input" maxlength="{{30}}" placeholder="输入分类名称" value="{{newRCatName}}" bindinput="onNewRCat" />
          <button class="new-category-button" bindtap="addRCategory" data-type="reward">添加分类</button>
        </view>
        <view class="new-category-row" wx:else>
          <input class="new-category-input" maxlength="{{30}}" placeholder="输入分类名称" value="{{newPCatName}}" bindinput="onNewPCat" />
          <button class="new-category-button" bindtap="addRCategory" data-type="punish">添加分类</button>
        </view>
      </view>
    </block>

    <view wx:if="{{ruleType === 'special'}}" class="special-rules-card">
      <view class="special-rules-head">
        <view>
          <text class="special-rules-title">我们家的约定</text>
          <text class="special-rules-copy">写成孩子也能读懂的一句话，尽量表达共同承诺。</text>
        </view>
        <ui-icon name="family-heart" size="48" theme="{{iconTheme}}" />
      </view>
      <view wx:if="{{editRules.special.length === 0}}" class="category-items-empty">还没有家庭约定，添加一条试试吧</view>
      <view wx:for="{{editRules.special}}" wx:key="*this" wx:for-index="si" class="special-edit-row">
        <text class="special-index">{{si + 1}}</text>
        <textarea class="special-input" auto-height maxlength="{{300}}" value="{{item}}" bindinput="onSpecial" data-si="{{si}}" placeholder="例如：遇到困难先说出来，我们一起想办法" />
        <button class="special-delete" bindtap="delSpecial" data-si="{{si}}">删除</button>
      </view>
      <button class="add-rule-row special-add" bindtap="addSpecial">＋ 添加家庭约定</button>
    </view>

    <view class="rules-save-spacer"></view>
    <view class="rules-fixed-save">
      <view class="rules-save-status">
        <text class="rules-save-dot {{ruleDirty ? 'dirty' : ''}}"></text>
        <view>
          <text class="rules-save-title">{{ruleDirty ? '有未保存修改' : '规则已是最新'}}</text>
          <text class="rules-save-sub">{{ruleDirty ? '已修改 ' + ruleChangeCount + ' 处' + (draftSavedAt ? ' · 草稿 ' + draftSavedAt : '') : '修改后统一保存整套规则'}}</text>
        </view>
      </view>
      <button wx:if="{{ruleDirty}}" class="rules-discard-btn" bindtap="discardRuleChanges">放弃</button>
      <button class="rules-save-btn" loading="{{rulesSaving}}" disabled="{{!ruleDirty || rulesSaving}}" bindtap="saveRules">保存</button>
    </view>

    <view wx:if="{{ruleEditorVisible}}" class="rule-editor-mask" catchtouchmove="noop">
      <view class="rule-editor-panel" catchtap="noop">
        <view class="rule-editor-head">
          <view>
            <text class="rule-editor-eyebrow">{{ruleEditor.type === 'punish' ? '用正数填写扣分值' : '把常用分值放在最前面'}}</text>
            <text class="rule-editor-title">{{ruleEditor.typeTitle}}</text>
          </view>
          <button class="rule-editor-close" bindtap="closeRuleEditor">×</button>
        </view>

        <view class="editor-field">
          <text class="editor-label">规则名称</text>
          <input class="editor-input {{ruleEditor.errors.editLabel ? 'error' : ''}}" maxlength="{{50}}" value="{{ruleEditor.editLabel}}" placeholder="孩子一看就明白的名称" bindinput="onRuleEditorInput" data-field="editLabel" />
          <text wx:if="{{ruleEditor.errors.editLabel}}" class="editor-error">{{ruleEditor.errors.editLabel}}</text>
          <text wx:if="{{!ruleEditor.isNew}}" class="rename-safety-tip">改名时会再次确认，并把旧名称保留为兼容别名。</text>
        </view>

        <view class="editor-score-card">
          <text class="editor-label">{{ruleEditor.scoreLabel}}</text>
          <view class="editor-score-line">
            <text class="editor-score-sign">{{ruleEditor.type === 'punish' ? '扣' : '+'}}</text>
            <input class="editor-score-input {{ruleEditor.errors.editDefault ? 'error' : ''}}" type="number" value="{{ruleEditor.editDefault}}" bindinput="onRuleEditorInput" data-field="editDefault" />
            <text class="editor-score-unit">分</text>
          </view>
          <text wx:if="{{ruleEditor.errors.editDefault}}" class="editor-error center">{{ruleEditor.errors.editDefault}}</text>
          <view class="editor-quick-scores">
            <button wx:for="{{quickScores}}" wx:key="*this" class="quick-score" bindtap="onRuleScoreQuick" data-value="{{item}}">{{ruleEditor.type === 'punish' ? '扣' : '+'}}{{item}}</button>
          </view>
        </view>

        <view class="editor-field">
          <text class="editor-label">计算方式 <text class="editor-optional">选填</text></text>
          <input class="editor-input {{ruleEditor.errors.editUnit ? 'error' : ''}}" maxlength="{{20}}" value="{{ruleEditor.editUnit}}" placeholder="例如：每次、每天、每科" bindinput="onRuleEditorInput" data-field="editUnit" />
          <text wx:if="{{ruleEditor.errors.editUnit}}" class="editor-error">{{ruleEditor.errors.editUnit}}</text>
        </view>

        <view class="editor-field">
          <text class="editor-label">给孩子的说明 <text class="editor-optional">选填</text></text>
          <textarea class="editor-textarea {{ruleEditor.errors.editHint ? 'error' : ''}}" maxlength="{{200}}" value="{{ruleEditor.editHint}}" placeholder="为什么这样做，尽量用温和、具体的话说明" bindinput="onRuleEditorInput" data-field="editHint" />
          <text wx:if="{{ruleEditor.errors.editHint}}" class="editor-error">{{ruleEditor.errors.editHint}}</text>
        </view>

        <view class="editor-advanced-toggle" bindtap="toggleRuleEditorAdvanced">
          <text>高级设置</text>
          <text>{{ruleEditorAdvanced ? '收起⌃' : '展开⌄'}}</text>
        </view>
        <view wx:if="{{ruleEditorAdvanced}}" class="editor-advanced-body">
          <text wx:if="{{ruleEditor.type === 'punish'}}" class="punish-number-tip">这里只填正数：最低扣 1 分、最高最多扣 500 分；保存时会自动转换为负数。</text>
          <view class="editor-range-row">
            <view class="editor-field range-field">
              <text class="editor-label">{{ruleEditor.rangeMinLabel}}</text>
              <input class="editor-input {{ruleEditor.errors.editMin ? 'error' : ''}}" type="number" value="{{ruleEditor.editMin}}" bindinput="onRuleEditorInput" data-field="editMin" />
              <text wx:if="{{ruleEditor.errors.editMin}}" class="editor-error">{{ruleEditor.errors.editMin}}</text>
            </view>
            <view class="editor-field range-field">
              <text class="editor-label">{{ruleEditor.rangeMaxLabel}}</text>
              <input class="editor-input {{ruleEditor.errors.editMax ? 'error' : ''}}" type="number" value="{{ruleEditor.editMax}}" bindinput="onRuleEditorInput" data-field="editMax" />
              <text wx:if="{{ruleEditor.errors.editMax}}" class="editor-error">{{ruleEditor.errors.editMax}}</text>
            </view>
          </view>
          <view class="editor-field system-id-field">
            <text class="editor-label">规则 ID <text class="editor-optional">保持唯一</text></text>
            <input class="editor-input {{ruleEditor.errors.id ? 'error' : ''}}" maxlength="{{64}}" value="{{ruleEditor.id}}" bindinput="onRuleEditorInput" data-field="id" />
            <text wx:if="{{ruleEditor.errors.id}}" class="editor-error">{{ruleEditor.errors.id}}</text>
          </view>
        </view>

        <view class="rule-editor-actions">
          <button wx:if="{{!ruleEditor.isNew}}" class="editor-delete-btn" bindtap="deleteRuleFromEditor">删除规则</button>
          <button class="editor-cancel-btn" bindtap="closeRuleEditor">取消</button>
          <button class="editor-done-btn" bindtap="completeRuleEditor">完成</button>
        </view>
      </view>
    </view>

    <view wx:if="{{undoVisible}}" class="rule-undo-bar">
      <text>{{undoMessage}}</text>
      <button bindtap="undoRuleDelete">撤销</button>
    </view>

    <view wx:if="{{rulesSaving}}" class="rules-saving-lock" catchtap="noop" catchtouchmove="noop">
      <view class="rules-saving-lock-card">
        <view class="rules-saving-spinner"></view>
        <text class="rules-saving-title">正在安全保存规则</text>
        <text class="rules-saving-copy">保存完成前暂时锁定编辑，避免新修改被覆盖。</text>
      </view>
    </view>
  </view>

  <!-- ========== 数据清理 ========== -->
  <view wx:if="{{adminTab === 'cleanup'}}" class="cleanup-section">
    <view class="card">
      <view class="section-title icon-heading"><ui-icon name="clean" size="34" theme="{{iconTheme}}" /><text>清理历史记录</text></view>
      <text class="cleanup-hint">此操作不可撤销，建议先备份</text>

      <view class="cleanup-row">
        <text class="cleanup-label">选择孩子</text>
        <picker range="{{cleanupKidOptions}}" range-key="name" value="{{cleanupKidIdx}}" bindchange="onCleanupKid">
          <view class="cleanup-picker">{{cleanupKidOptions[cleanupKidIdx].name}}</view>
        </picker>
      </view>

      <view class="cleanup-row">
        <text class="cleanup-label">截止日期</text>
        <picker mode="date" value="{{cleanupBefore}}" bindchange="onCleanupBefore">
          <text class="cleanup-date">{{cleanupBefore || '选择日期'}}</text>
        </picker>
        <text class="cleanup-hint2">清理该日期 {{cleanupBefore ? '及之前' : ''}} 的记录</text>
      </view>

      <view class="cleanup-row">
        <text class="cleanup-label">起始日期</text>
        <picker mode="date" value="{{cleanupAfter}}" bindchange="onCleanupAfter">
          <text class="cleanup-date">{{cleanupAfter || '选择日期（可选）'}}</text>
        </picker>
        <text class="cleanup-hint2">{{cleanupAfter ? '清理该日期及之后的记录' : '不填则清理全部符合的记录'}}</text>
      </view>

      <view class="cleanup-actions">
        <button class="btn btn-xs" bindtap="onCleanupPreview">预览匹配数</button>
        <button class="btn btn-danger btn-xs" bindtap="onCleanupExec">确认清理</button>
      </view>

      <view wx:if="{{cleanupPreviewCount >= 0}}" class="cleanup-result">
        <text>匹配 <text class="cr-count">{{cleanupPreviewCount}}</text> 条记录</text>
      </view>
    </view>

    <view class="save-bar">
      <button class="btn btn-outline" bindtap="goBack">返回</button>
    </view>
  </view>

</view>

<!-- Toast -->
<toast-msg message="{{toastMessage}}" show="{{toastVisible}}" />
