/* pages/admin/admin.wxss */
.page-container {
  padding: 24rpx 28rpx;
  padding-bottom: 80rpx;
}
.skin-row { margin-top: 10rpx; padding-top: 12rpx; border-top: 1rpx dashed var(--border); }
.skin-picker { min-width: 180rpx; color: var(--amber); font-weight: 600; }
.skin-local-hint { margin-left: auto; color: var(--muted); font-size: var(--font-xs); }

.admin-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.admin-tab {
  flex: 1;
  padding: 20rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--border);
  background: var(--card);
  font-size: var(--font-md);
  text-align: center;
}
.admin-tab.active {
  background: var(--amber);
  color: #fff;
  border-color: var(--amber);
}

/* 用户管理 */
.user-edit-card {
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  margin-bottom: 12rpx;
  background: var(--card);
}
.ue-index {
  font-size: var(--font-sm);
  color: var(--muted);
  display: block;
  margin-bottom: 8rpx;
}
.ue-row {
  display: flex;
  gap: 8rpx;
  align-items: center;
  margin-bottom: 8rpx;
}
.ue-input {
  padding: 12rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  width: 120rpx;
}
.ue-pwd {
  flex: 1;
}
.ue-label {
  font-size: var(--font-sm);
  color: var(--muted);
  min-width: 56rpx;
}
.ue-picker {
  padding: 12rpx 16rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  background: var(--card);
}
.btn-del {
  background: #E24B4A;
  color: #fff;
  padding: 12rpx 16rpx;
}

.add-section {
  margin-top: 24rpx;
}
.add-title {
  font-size: var(--font-sm);
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}
.add-row {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}
.add-input {
  padding: 12rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  width: 120rpx;
}
.add-picker {
  width: 120rpx;
}

/* 规则工作台：先看摘要，再进入单条编辑。 */
.rules-admin {
  padding-bottom: 180rpx;
}

.rules-overview-card,
.rule-category-card,
.new-category-card,
.special-rules-card {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
}

.rules-overview-card {
  padding: 28rpx;
  background: linear-gradient(145deg, var(--card), var(--amber-light));
}

.rules-overview-head,
.rule-category-title-row,
.special-rules-head,
.rules-save-status,
.rule-editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.rules-eyebrow,
.rule-editor-eyebrow {
  display: block;
  color: var(--amber);
  font-size: var(--font-xs);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.rules-overview-title,
.rule-editor-title {
  display: block;
  margin-top: 4rpx;
  color: var(--text);
  font-size: var(--font-lg);
  font-weight: 800;
}

.rules-counts {
  display: flex;
  gap: 10rpx;
  margin-top: 22rpx;
  flex-wrap: wrap;
}

.rules-counts text {
  padding: 8rpx 16rpx;
  color: var(--amber-dark);
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  font-size: var(--font-xs);
  font-weight: 700;
}

.rules-overview-tip,
.special-rules-copy {
  display: block;
  margin-top: 16rpx;
  color: var(--muted);
  font-size: var(--font-xs);
  line-height: 1.6;
}

.rules-draft-status {
  display: inline-block;
  padding: 8rpx 14rpx;
  margin-top: 12rpx;
  color: var(--amber-dark);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: var(--font-xs);
  font-weight: 700;
}

.rule-type-tabs {
  display: flex;
  gap: 10rpx;
  padding: 10rpx;
  margin: 22rpx 0;
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  background: rgba(255, 255, 255, 0.62);
}

.rule-type-tab {
  min-width: 0;
  min-height: 78rpx;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 0 8rpx;
  border-radius: var(--radius-sm);
  color: var(--muted);
  font-size: var(--font-xs);
  font-weight: 700;
}

.rule-type-tab.active {
  color: #FFFFFF;
  background: linear-gradient(135deg, var(--amber), var(--amber-dark));
  box-shadow: 0 8rpx 20rpx rgba(45, 120, 94, 0.2);
}

.rule-type-tab.punish.active {
  background: linear-gradient(135deg, #E47A66, #C85B55);
  box-shadow: 0 8rpx 20rpx rgba(200, 91, 85, 0.2);
}

.rule-type-tab.special.active {
  background: linear-gradient(135deg, #E6A945, #C98228);
  box-shadow: 0 8rpx 20rpx rgba(201, 130, 40, 0.2);
}

.rule-type-count {
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  text-align: center;
  line-height: 30rpx;
  background: rgba(255, 255, 255, 0.48);
}

.rule-validation-banner {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  color: #A14B43;
  border: 1rpx solid rgba(226, 75, 74, 0.2);
  border-radius: var(--radius-sm);
  background: #FFF3F0;
  font-size: var(--font-xs);
}

.rule-validation-banner > text {
  min-width: 0;
  flex: 1;
}

.conflict-load-btn {
  height: 56rpx;
  flex: 0 0 auto;
  margin: 0;
  padding: 0 16rpx;
  color: #FFFFFF;
  border-radius: 999rpx;
  background: #B75850;
  font-size: var(--font-xs);
  line-height: 56rpx;
}

.rule-category-card {
  margin-bottom: 16rpx;
  overflow: hidden;
}

.rule-category-card.expanded {
  border-color: rgba(45, 155, 122, 0.3);
  box-shadow: var(--shadow);
}

.rule-category-card.punish.expanded {
  border-color: rgba(226, 122, 102, 0.34);
}

.rule-category-summary {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
}

.rule-category-icon {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: var(--amber-light);
}

.punish .rule-category-icon {
  background: #FFF0EB;
}

.rule-category-copy,
.rule-summary-copy {
  min-width: 0;
  flex: 1;
}

.rule-category-title {
  min-width: 0;
  flex: 1;
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 750;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rule-category-count {
  flex: 0 0 auto;
  color: var(--amber);
  font-size: var(--font-xs);
  font-weight: 700;
}

.rule-category-preview {
  display: block;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: var(--font-xs);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rule-category-arrow {
  flex: 0 0 auto;
  color: var(--amber);
  font-size: var(--font-xs);
}

.rule-category-body {
  padding: 0 20rpx 20rpx;
  border-top: 1rpx solid var(--border);
}

.category-edit-row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  padding: 18rpx 0;
}

.category-tools {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 0 16rpx;
  overflow-x: auto;
}

.category-tools button,
.rule-row-tools button,
.rule-move-picker {
  min-width: 88rpx;
  height: 54rpx;
  flex: 0 0 auto;
  margin: 0;
  padding: 0 14rpx;
  color: var(--amber-dark);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  background: var(--amber-light);
  font-size: var(--font-xs);
  line-height: 54rpx;
  text-align: center;
}

.category-tools button[disabled],
.rule-row-tools button[disabled] {
  color: #B7BDBA;
  background: #F4F5F4;
}

.category-name-field {
  min-width: 0;
  flex: 1;
}

.compact-label,
.editor-label {
  display: block;
  margin-bottom: 8rpx;
  color: var(--muted);
  font-size: var(--font-xs);
  font-weight: 650;
}

.compact-input,
.new-category-input,
.editor-input,
.editor-textarea,
.special-input {
  box-sizing: border-box;
  width: 100%;
  color: var(--text);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.76);
  font-size: var(--font-sm);
}

.compact-input,
.new-category-input,
.editor-input {
  min-height: 76rpx;
  padding: 0 18rpx;
}

.category-delete-btn,
.special-delete,
.editor-delete-btn {
  flex: 0 0 auto;
  margin: 0;
  color: #B75850;
  border: 1rpx solid rgba(226, 75, 74, 0.2);
  border-radius: var(--radius-sm);
  background: #FFF3F0;
  font-size: var(--font-xs);
}

.category-delete-btn {
  height: 76rpx;
  padding: 0 18rpx;
  line-height: 76rpx;
}

.rule-summary-row {
  min-height: 94rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 4rpx;
  border-top: 1rpx solid var(--border);
  flex-wrap: wrap;
}

.rule-summary-name {
  display: -webkit-box;
  color: var(--text);
  font-size: var(--font-sm);
  font-weight: 700;
  line-height: 1.35;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.rule-summary-meta {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: var(--font-xs);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rule-summary-score {
  min-width: 110rpx;
  flex: 0 0 auto;
  padding: 8rpx 12rpx;
  color: var(--amber-dark);
  border-radius: 999rpx;
  background: var(--amber-light);
  font-size: var(--font-xs);
  font-weight: 800;
  text-align: center;
  white-space: nowrap;
}

.rule-row-main {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rule-row-tools {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  padding-top: 10rpx;
}

.rule-row-tools button,
.rule-move-picker {
  min-width: 72rpx;
  height: 50rpx;
  padding: 0 12rpx;
  line-height: 50rpx;
}

.rule-template-shelf {
  padding: 18rpx;
  margin-top: 14rpx;
  border: 1rpx dashed var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface-soft, var(--amber-light));
}

.template-title {
  display: block;
  color: var(--text);
  font-size: var(--font-xs);
  font-weight: 750;
}

.template-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-top: 12rpx;
}

.template-grid button {
  height: 58rpx;
  margin: 0;
  padding: 0;
  color: var(--amber-dark);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.82);
  font-size: var(--font-xs);
  line-height: 58rpx;
}

.template-tip,
.rename-safety-tip {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: var(--font-xs);
  line-height: 1.5;
}

.punish .rule-summary-score {
  color: #B75850;
  background: #FFF0EB;
}

.rule-summary-chevron {
  flex: 0 0 auto;
  color: var(--muted);
  font-size: var(--font-lg);
}

.add-rule-row {
  width: 100%;
  min-height: 82rpx;
  margin: 12rpx 0 0;
  color: var(--amber);
  border: 2rpx dashed var(--border);
  border-radius: var(--radius-sm);
  background: var(--amber-light);
  font-size: var(--font-sm);
  font-weight: 700;
}

.category-items-empty,
.rule-empty-state {
  color: var(--muted);
  font-size: var(--font-xs);
  text-align: center;
}

.category-items-empty {
  padding: 26rpx 12rpx;
  border-top: 1rpx solid var(--border);
}

.rule-empty-state {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 52rpx 28rpx;
  margin-bottom: 16rpx;
  border: 2rpx dashed var(--border);
  border-radius: var(--radius);
  background: rgba(255, 255, 255, 0.48);
}

.rule-empty-title {
  margin-top: 14rpx;
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 750;
}

.rule-empty-copy {
  margin-top: 8rpx;
  line-height: 1.6;
}

.new-category-card {
  padding: 22rpx;
  margin-top: 18rpx;
}

.new-category-title {
  display: block;
  margin-bottom: 12rpx;
  color: var(--text);
  font-size: var(--font-sm);
  font-weight: 750;
}

.new-category-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.new-category-input {
  min-width: 0;
  flex: 1;
}

.new-category-button {
  height: 76rpx;
  flex: 0 0 auto;
  margin: 0;
  padding: 0 24rpx;
  color: #FFFFFF;
  border-radius: var(--radius-sm);
  background: var(--amber);
  font-size: var(--font-xs);
  font-weight: 700;
  line-height: 76rpx;
}

.special-rules-card {
  padding: 24rpx;
}

.special-rules-title {
  display: block;
  color: var(--text);
  font-size: var(--font-lg);
  font-weight: 800;
}

.special-rules-copy {
  margin-top: 6rpx;
}

.special-edit-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--border);
}

.special-index {
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 46rpx;
  color: #A86720;
  border-radius: 50%;
  background: #FFF0CC;
  font-size: var(--font-xs);
  font-weight: 800;
  line-height: 46rpx;
  text-align: center;
}

.special-input {
  min-height: 76rpx;
  flex: 1;
  padding: 16rpx 18rpx;
  line-height: 1.5;
}

.special-delete {
  padding: 10rpx 14rpx;
}

.special-add {
  color: #A86720;
  background: #FFF7E5;
}

/* 固定保存栏 */
.rules-save-spacer {
  height: 40rpx;
}

.rules-fixed-save {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border);
  background: #FFFEFB;
  box-shadow: 0 -12rpx 34rpx rgba(50, 42, 35, 0.1);
}

.rules-save-status {
  min-width: 0;
  flex: 1;
  justify-content: flex-start;
}

.rules-save-dot {
  width: 16rpx;
  height: 16rpx;
  flex: 0 0 16rpx;
  border-radius: 50%;
  background: #AEB8B2;
}

.rules-save-dot.dirty {
  background: #F0A43D;
  box-shadow: 0 0 0 8rpx rgba(240, 164, 61, 0.12);
}

.rules-save-title,
.rules-save-sub {
  display: block;
}

.rules-save-title {
  color: var(--text);
  font-size: var(--font-xs);
  font-weight: 750;
}

.rules-save-sub {
  margin-top: 2rpx;
  color: var(--muted);
  font-size: var(--font-xs);
}

.rules-discard-btn,
.rules-save-btn {
  height: 72rpx;
  flex: 0 0 auto;
  margin: 0;
  padding: 0 22rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  font-weight: 750;
  line-height: 72rpx;
}

.rules-discard-btn {
  color: var(--muted);
  border: 1rpx solid var(--border);
  background: #FFFFFF;
}

.rules-save-btn {
  color: #FFFFFF;
  background: var(--amber);
}

.rules-save-btn[disabled] {
  color: #FFFFFF;
  background: #B9C7C1;
}

/* 单条规则编辑面板 */
.rule-editor-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(28, 35, 32, 0.56);
}

.rule-editor-panel {
  box-sizing: border-box;
  width: 100%;
  max-height: 90vh;
  padding: 30rpx 28rpx calc(26rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 42rpx 42rpx 0 0;
  background: #FFFEFB;
  box-shadow: 0 -20rpx 60rpx rgba(28, 35, 32, 0.2);
}

.rule-editor-head {
  margin-bottom: 24rpx;
}

.rule-editor-close {
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  margin: 0;
  padding: 0;
  color: var(--muted);
  border-radius: 50%;
  background: var(--bg);
  font-size: var(--font-xl);
  font-weight: 300;
  line-height: 64rpx;
}

.editor-field {
  margin-top: 20rpx;
}

.editor-optional {
  color: #AF9F94;
  font-weight: 400;
}

.editor-input:focus,
.editor-textarea:focus {
  border-color: var(--amber);
}

.editor-input.error,
.editor-textarea.error,
.editor-score-input.error {
  border-color: var(--red);
  background: #FFF8F6;
}

.editor-textarea {
  min-height: 132rpx;
  padding: 18rpx;
  line-height: 1.55;
}

.editor-error {
  display: block;
  margin-top: 8rpx;
  color: var(--red);
  font-size: var(--font-xs);
}

.editor-error.center {
  text-align: center;
}

.editor-score-card {
  padding: 22rpx;
  margin-top: 20rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  background: linear-gradient(145deg, var(--amber-light), rgba(255, 255, 255, 0.88));
}

.editor-score-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.editor-score-sign,
.editor-score-unit {
  color: var(--amber);
  font-size: var(--font-lg);
  font-weight: 800;
}

.editor-score-input {
  box-sizing: border-box;
  width: 180rpx;
  height: 88rpx;
  color: var(--amber-dark);
  border: 2rpx solid rgba(45, 155, 122, 0.2);
  border-radius: var(--radius-sm);
  background: #FFFFFF;
  font-size: var(--font-xl);
  font-weight: 900;
  text-align: center;
}

.editor-quick-scores {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}

.quick-score {
  height: 60rpx;
  min-width: 0;
  flex: 1 0 112rpx;
  margin: 0;
  padding: 0;
  color: var(--amber-dark);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  font-size: var(--font-xs);
  line-height: 60rpx;
}

.rule-undo-bar {
  position: fixed;
  right: 28rpx;
  bottom: calc(126rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  z-index: 260;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 18rpx 16rpx 24rpx;
  color: #FFFFFF;
  border-radius: 24rpx;
  background: rgba(34, 50, 44, 0.94);
  box-shadow: 0 12rpx 34rpx rgba(25, 35, 31, 0.25);
  font-size: var(--font-xs);
}

.rule-undo-bar text {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rule-undo-bar button {
  height: 56rpx;
  flex: 0 0 auto;
  margin: 0;
  padding: 0 18rpx;
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 999rpx;
  background: transparent;
  font-size: var(--font-xs);
  font-weight: 800;
  line-height: 56rpx;
}

.rules-saving-lock {
  position: fixed;
  inset: 0;
  z-index: 2200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(35, 54, 48, 0.28);
  backdrop-filter: blur(8rpx);
}

.rules-saving-lock-card {
  width: 86%;
  max-width: 560rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 42rpx 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 24rpx 64rpx rgba(31, 112, 88, 0.22);
}

.rules-saving-spinner {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 20rpx;
  border: 6rpx solid rgba(45, 155, 122, 0.18);
  border-top-color: var(--theme-primary, #2D9B7A);
  border-radius: 50%;
  animation: rules-saving-spin 0.8s linear infinite;
}

.rules-saving-title {
  color: var(--text-primary, #332C27);
  font-size: var(--font-lg, 36rpx);
  font-weight: 700;
}

.rules-saving-copy {
  margin-top: 10rpx;
  color: var(--text-secondary, #8D8178);
  font-size: var(--font-sm, 26rpx);
  line-height: 1.6;
  text-align: center;
}

@keyframes rules-saving-spin {
  to { transform: rotate(360deg); }
}

.editor-advanced-toggle {
  min-height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-top: 18rpx;
  color: var(--amber);
  border-top: 1rpx solid var(--border);
  font-size: var(--font-sm);
  font-weight: 750;
}

.editor-advanced-body {
  padding: 20rpx;
  border-radius: var(--radius-sm);
  background: var(--bg);
}

.punish-number-tip {
  display: block;
  padding: 14rpx 16rpx;
  color: #9D554D;
  border-radius: 14rpx;
  background: #FFF1EC;
  font-size: var(--font-xs);
  line-height: 1.55;
}

.editor-range-row {
  display: flex;
  gap: 14rpx;
}

.range-field {
  min-width: 0;
  flex: 1;
}

.system-id-field {
  padding-top: 16rpx;
  margin-top: 16rpx;
  border-top: 1rpx dashed var(--border);
}

.rule-editor-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 26rpx;
}

.rule-editor-actions button {
  height: 78rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  font-weight: 750;
  line-height: 78rpx;
}

.editor-delete-btn {
  padding: 0 18rpx !important;
}

.editor-cancel-btn {
  flex: 1;
  color: var(--amber);
  border: 2rpx solid var(--amber);
  background: #FFFFFF;
}

.editor-done-btn {
  flex: 1.4;
  color: #FFFFFF;
  background: linear-gradient(135deg, var(--amber), var(--amber-dark));
  box-shadow: 0 8rpx 22rpx rgba(45, 155, 122, 0.2);
}

/* 保存栏 */
.save-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.save-main {
  flex: 1;
  padding: 24rpx;
}

/* 数据清理 */
.cleanup-section {
  padding: 0;
}
.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}
.cleanup-hint {
  font-size: var(--font-xs);
  color: var(--red, #E24B4A);
  display: block;
  margin-bottom: 20rpx;
}
.cleanup-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}
.cleanup-label {
  font-size: var(--font-sm);
  color: var(--muted);
  min-width: 100rpx;
}
.cleanup-picker {
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  background: var(--card);
}
.cleanup-date {
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  background: var(--card);
  display: inline-block;
}
.cleanup-hint2 {
  font-size: var(--font-xs);
  color: #999;
}
.cleanup-actions {
  display: flex;
  gap: 12rpx;
  margin: 20rpx 0 16rpx;
}
.cleanup-actions .btn {
  flex: 1;
  padding: 14rpx 0;
  font-size: var(--font-sm);
}
.btn-danger {
  background: #E24B4A;
  color: #fff;
}
.cleanup-result {
  padding: 16rpx;
  background: var(--amber-light);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  text-align: center;
}
.cr-count {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--amber);
}
/* 自有图标标题在管理页保持与其他页面一致。 */
.rule-sec-title.icon-heading,
.section-title.icon-heading { display: flex; }
