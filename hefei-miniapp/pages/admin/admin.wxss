/* pages/admin/admin.wxss */
.page-container {
  padding: 24rpx 28rpx;
  padding-bottom: 80rpx;
}
.skin-row { margin-top: 10rpx; padding-top: 12rpx; border-top: 1rpx dashed var(--border); }
.skin-picker { min-width: 180rpx; color: var(--amber); font-weight: 600; }
.skin-local-hint { margin-left: auto; color: var(--muted); font-size: var(--font-xs); }

.admin-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.admin-tab {
  flex: 1;
  padding: 20rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--border);
  background: var(--card);
  font-size: var(--font-md);
  text-align: center;
}
.admin-tab.active {
  background: var(--amber);
  color: #fff;
  border-color: var(--amber);
}

/* 用户管理 */
.user-edit-card {
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  margin-bottom: 12rpx;
  background: var(--card);
}
.ue-index {
  font-size: var(--font-sm);
  color: var(--muted);
  display: block;
  margin-bottom: 8rpx;
}
.ue-row {
  display: flex;
  gap: 8rpx;
  align-items: center;
  margin-bottom: 8rpx;
}
.ue-input {
  padding: 12rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  width: 120rpx;
}
.ue-pwd {
  flex: 1;
}
.ue-label {
  font-size: var(--font-sm);
  color: var(--muted);
  min-width: 56rpx;
}
.ue-picker {
  padding: 12rpx 16rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  background: var(--card);
}
.btn-del {
  background: #E24B4A;
  color: #fff;
  padding: 12rpx 16rpx;
}

.add-section {
  margin-top: 24rpx;
}
.add-title {
  font-size: var(--font-sm);
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}
.add-row {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}
.add-input {
  padding: 12rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  width: 120rpx;
}
.add-picker {
  width: 120rpx;
}

/* 规则编辑 */
.rule-section {
  margin-bottom: 24rpx;
}
.rule-sec-title {
  font-size: var(--font-md);
  font-weight: 600;
  display: block;
  margin: 16rpx 0 12rpx;
}
.rule-cat-edit {
  border: 1rpx solid #C8E6C9;
  border-radius: var(--radius-sm);
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: var(--card);
}
.punish-edit {
  border-color: #FFCDD2;
  background: var(--card);
}
.rce-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.rce-label {
  font-size: var(--font-sm);
  color: var(--muted);
}
.rce-input {
  flex: 1;
  padding: 12rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  font-weight: 600;
}
.btn-small-green {
  background: #E8F5E9;
  color: #388E3C;
  border: 1rpx solid #A5D6A7;
  padding: 8rpx 12rpx;
  font-size: var(--font-xs);
}
.btn-small-red {
  background: #FFEBEE;
  color: #D32F2F;
  border: 1rpx solid #EF9A9A;
  padding: 8rpx 12rpx;
  font-size: var(--font-xs);
}
.btn-small {
  background: var(--bg);
  color: #999;
  padding: 8rpx 12rpx;
  font-size: var(--font-xs);
}

.rce-item {
  border: 1rpx solid #C8E6C9;
  border-radius: var(--radius-sm);
  padding: 16rpx;
  margin-bottom: 8rpx;
  background: var(--card);
}
.punish-edit .rce-item {
  border-color: #FFEBEE;
  background: var(--card);
}
.rce-item-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-wrap: wrap;
}
.rce-si-input {
  width: 120rpx;
  padding: 8rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  font-weight: 500;
}
.rce-si-num {
  width: 60rpx;
  padding: 8rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  text-align: center;
}
.rce-hint {
  font-size: var(--font-xs);
  color: var(--muted);
}
.rce-unit {
  width: 100%;
  padding: 8rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  margin-top: 8rpx;
}

.add-cat-row {
  display: flex;
  gap: 8rpx;
  align-items: center;
  margin-bottom: 8rpx;
}

/* 特别规则 */
.special-edit-row {
  display: flex;
  gap: 8rpx;
  align-items: center;
  margin-bottom: 8rpx;
}
.special-input {
  flex: 1;
  padding: 12rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
}
.btn-add-special {
  background: var(--amber-light);
  color: var(--amber);
  border: 1rpx solid var(--border);
  font-weight: 500;
  padding: 12rpx 24rpx;
  font-size: var(--font-sm);
}

/* 保存栏 */
.save-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.save-main {
  flex: 1;
  padding: 24rpx;
}

/* 数据清理 */
.cleanup-section {
  padding: 0;
}
.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}
.cleanup-hint {
  font-size: var(--font-xs);
  color: var(--red, #E24B4A);
  display: block;
  margin-bottom: 20rpx;
}
.cleanup-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}
.cleanup-label {
  font-size: var(--font-sm);
  color: var(--muted);
  min-width: 100rpx;
}
.cleanup-picker {
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  background: var(--card);
}
.cleanup-date {
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  background: var(--card);
  display: inline-block;
}
.cleanup-hint2 {
  font-size: var(--font-xs);
  color: #999;
}
.cleanup-actions {
  display: flex;
  gap: 12rpx;
  margin: 20rpx 0 16rpx;
}
.cleanup-actions .btn {
  flex: 1;
  padding: 14rpx 0;
  font-size: var(--font-sm);
}
.btn-danger {
  background: #E24B4A;
  color: #fff;
}
.cleanup-result {
  padding: 16rpx;
  background: var(--amber-light);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  text-align: center;
}
.cr-count {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--amber);
}
/* 自有图标标题在管理页保持与其他页面一致。 */
.rule-sec-title.icon-heading,
.section-title.icon-heading { display: flex; }
