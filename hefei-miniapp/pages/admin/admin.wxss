/* pages/admin/admin.wxss */
.page-container {
  padding: 24rpx 28rpx;
  padding-bottom: 80rpx;
}

.admin-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.admin-tab {
  flex: 1;
  padding: 20rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--border);
  background: var(--card);
  font-size: 28rpx;
  text-align: center;
}
.admin-tab.active {
  background: var(--amber);
  color: #fff;
  border-color: var(--amber);
}

/* 用户管理 */
.user-edit-card {
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  margin-bottom: 12rpx;
  background: #fafafa;
}
.ue-index {
  font-size: 24rpx;
  color: var(--muted);
  display: block;
  margin-bottom: 8rpx;
}
.ue-row {
  display: flex;
  gap: 8rpx;
  align-items: center;
  margin-bottom: 8rpx;
}
.ue-input {
  padding: 12rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 24rpx;
  width: 120rpx;
}
.ue-pwd {
  flex: 1;
}
.ue-label {
  font-size: 24rpx;
  color: var(--muted);
  min-width: 56rpx;
}
.ue-picker {
  padding: 12rpx 16rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 24rpx;
  background: var(--card);
}
.btn-del {
  background: #E24B4A;
  color: #fff;
  padding: 12rpx 16rpx;
}

.add-section {
  margin-top: 24rpx;
}
.add-title {
  font-size: 26rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}
.add-row {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}
.add-input {
  padding: 12rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 24rpx;
  width: 120rpx;
}
.add-picker {
  width: 120rpx;
}

/* 规则编辑 */
.rule-section {
  margin-bottom: 24rpx;
}
.rule-sec-title {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin: 16rpx 0 12rpx;
}
.rule-cat-edit {
  border: 1rpx solid #C8E6C9;
  border-radius: var(--radius-sm);
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #fafffa;
}
.punish-edit {
  border-color: #FFCDD2;
  background: #fffafa;
}
.rce-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.rce-label {
  font-size: 24rpx;
  color: var(--muted);
}
.rce-input {
  flex: 1;
  padding: 12rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.btn-small-green {
  background: #E8F5E9;
  color: #388E3C;
  border: 1rpx solid #A5D6A7;
  padding: 8rpx 12rpx;
  font-size: 22rpx;
}
.btn-small-red {
  background: #FFEBEE;
  color: #D32F2F;
  border: 1rpx solid #EF9A9A;
  padding: 8rpx 12rpx;
  font-size: 22rpx;
}
.btn-small {
  background: #f5f5f5;
  color: #999;
  padding: 8rpx 12rpx;
  font-size: 22rpx;
}

.rce-item {
  border: 1rpx solid #C8E6C9;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 8rpx;
  background: #FAFFFA;
}
.punish-edit .rce-item {
  border-color: #FFEBEE;
  background: #FFFAFA;
}
.rce-item-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-wrap: wrap;
}
.rce-si-input {
  width: 120rpx;
  padding: 8rpx;
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.rce-si-num {
  width: 60rpx;
  padding: 8rpx;
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
  font-size: 22rpx;
  text-align: center;
}
.rce-hint {
  font-size: 20rpx;
  color: var(--muted);
}
.rce-unit {
  width: 100%;
  padding: 8rpx;
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.add-cat-row {
  display: flex;
  gap: 8rpx;
  align-items: center;
  margin-bottom: 8rpx;
}

/* 特别规则 */
.special-edit-row {
  display: flex;
  gap: 8rpx;
  align-items: center;
  margin-bottom: 8rpx;
}
.special-input {
  flex: 1;
  padding: 12rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 24rpx;
}
.btn-add-special {
  background: #FFF3E0;
  color: var(--amber);
  border: 1rpx solid #FFE0B2;
  font-weight: 500;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

/* 保存栏 */
.save-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.save-main {
  flex: 1;
  padding: 24rpx;
}
