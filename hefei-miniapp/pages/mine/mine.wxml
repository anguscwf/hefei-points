<!-- pages/mine/mine.wxml -->
<page-meta page-style="{{themePageStyle}}"></page-meta>
<view class="page-container {{themeClass}}">

  <!-- 用户卡片 -->
  <view class="user-card card">
    <view class="profile-sun profile-sun-a"></view>
    <view class="profile-sun profile-sun-b"></view>
    <view class="user-row">
      <view class="user-avatar">
        <image wx:if="{{userAvatar}}" src="{{userAvatar}}" mode="aspectFill" />
        <ui-icon wx:else name="{{userIcon}}" size="60" theme="{{theme}}" />
      </view>
      <view class="user-info">
        <text class="user-name">{{userName}}</text>
        <text class="user-role">{{roleText}}</text>
      </view>
    </view>
    <text class="profile-warmth" wx:if="{{isLoggedIn}}">一家人认真生活的每一天，都值得被收藏</text>
    <view class="avatar-actions" wx:if="{{isLoggedIn}}">
      <button class="btn btn-outline btn-xs" bindtap="onChooseAvatar"><view class="icon-button-label"><ui-icon name="camera" size="28" theme="{{theme}}" variant="white" /><text>更换头像</text></view></button>
      <button class="avatar-reset" wx:if="{{userAvatar}}" bindtap="onResetAvatar">恢复默认</button>
    </view>
    <view class="user-stats" wx:if="{{isLoggedIn}}">
      <view class="us-item">
        <text class="us-val score-total">{{totalPoints}}</text>
        <text class="us-label">{{pointsLabel}}</text>
      </view>
      <view class="us-item">
        <text class="us-val">{{recordCount}}</text>
        <text class="us-label">记录总数</text>
      </view>
    </view>
  </view>

  <!-- 未登录 -->
  <view wx:if="{{!isLoggedIn}}" class="perm-hint">
    <text>请先在首页登录</text>
    <text class="hint-link" bindtap="goIndex">→ 去登录</text>
  </view>

  <block wx:if="{{isLoggedIn}}">
    <view class="card theme-card">
      <view class="section-title icon-heading"><view class="section-icon"><ui-icon name="palette" size="34" theme="{{theme}}" /></view><text>家庭主题</text></view>
      <text class="theme-hint">选择后立即生效，并保存在本机</text>
      <view class="theme-options">
        <view class="theme-option {{theme === 'amber' ? 'selected' : ''}}" bindtap="onThemeChange" data-theme="amber">
          <view class="theme-swatch amber-swatch"></view><text>琥珀暖色</text><text class="theme-check">{{theme === 'amber' ? '✓' : ''}}</text>
        </view>
        <view class="theme-option {{theme === 'mint' ? 'selected' : ''}}" bindtap="onThemeChange" data-theme="mint">
          <view class="theme-swatch mint-swatch"></view><text>薄荷绿</text><text class="theme-check">{{theme === 'mint' ? '✓' : ''}}</text>
        </view>
      </view>
    </view>

    <!-- 积分规则摘要：完整内容统一在首页规则中心阅读 -->
    <view class="card rule-summary-card">
      <view class="rule-summary-head" bindtap="goRulesCenter">
        <view class="section-icon rule-summary-icon"><ui-icon name="clipboard" size="36" theme="{{theme}}" /></view>
        <view class="rule-summary-copy">
          <text class="rule-summary-title">{{ruleSummaryTitle}}</text>
          <text class="rule-summary-intro">{{ruleSummaryIntro}}</text>
        </view>
        <text class="rule-summary-arrow">›</text>
      </view>

      <view wx:if="{{!ruleSummary.isEmpty}}">
        <text class="rule-summary-total">{{ruleSummary.categoryCount}} 个分类 · {{ruleSummary.ruleCount}} 条积分规则 · {{ruleSummary.specialCount}} 条家庭约定</text>
        <view class="rule-summary-stats">
          <view class="rule-summary-stat reward">
            <text class="rule-summary-stat-value">{{ruleSummary.rewardCount}}</text>
            <text class="rule-summary-stat-label">{{isChild ? '赚糖' : '鼓励加分'}}</text>
          </view>
          <view class="rule-summary-stat punish">
            <text class="rule-summary-stat-value">{{ruleSummary.punishCount}}</text>
            <text class="rule-summary-stat-label">{{isChild ? '护糖' : '改进提醒'}}</text>
          </view>
          <view class="rule-summary-stat special">
            <text class="rule-summary-stat-value">{{ruleSummary.specialCount}}</text>
            <text class="rule-summary-stat-label">家庭约定</text>
          </view>
        </view>
      </view>

      <view wx:else class="rule-summary-empty">
        <text class="rule-summary-empty-title">家庭规则还在准备中</text>
        <text class="rule-summary-empty-copy">{{isChild ? '可以和家长一起商量第一条成长约定' : '管理员可进入后台添加规则'}}</text>
      </view>

      <view class="rule-summary-actions">
        <button class="btn btn-primary rule-summary-primary" bindtap="goRulesCenter">查看全部规则</button>
        <button wx:if="{{isAdmin}}" class="btn btn-outline rule-summary-admin" bindtap="goAdmin">管理规则</button>
      </view>
    </view>

    <!-- 管理后台入口 -->
    <view class="card menu-card" wx:if="{{isAdmin}}" bindtap="goAdmin">
      <view class="menu-row">
        <view class="menu-icon"><ui-icon name="settings" size="38" theme="{{theme}}" /></view>
        <text class="menu-text">管理后台</text>
        <text class="menu-arrow">→</text>
      </view>
      <text class="menu-desc">用户管理 · 积分规则管理</text>
    </view>

  </block>

  <!-- 版本与备案信息始终位于页面底部 -->
  <view class="app-footer">
    <text class="version-text">糖罐育儿积分 v{{version}}</text>
    <text class="filing-text">粤ICP备2026059273号-1X</text>
  </view>

</view>

<!-- Toast -->
<toast-msg message="{{toastMessage}}" show="{{toastVisible}}" />
<avatar-cropper
  show="{{cropVisible}}"
  src="{{cropSource}}"
  accent="{{theme === 'mint' ? '#2D9B7A' : '#B86932'}}"
  bind:cancel="onCropCancel"
  bind:apply="onCropApply"
/>
