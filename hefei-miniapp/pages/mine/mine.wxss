/* pages/mine/mine.wxss */
.page-container {
  padding: 24rpx 28rpx;
  padding-bottom: 80rpx;
}

/* 用户卡片 */
.user-card {
  text-align: center;
}
.user-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--amber-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}
.user-info {
  text-align: left;
}
.user-name {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
}
.user-role {
  font-size: 24rpx;
  color: var(--muted);
}
.user-stats {
  display: flex;
  justify-content: center;
  gap: 0;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}
.us-item {
  flex: 1;
}
.us-val {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--amber);
  display: block;
}
.us-label {
  font-size: 22rpx;
  color: var(--muted);
}

/* 提示 */
.hint-link {
  color: var(--amber);
  margin-left: 8rpx;
  font-weight: 500;
}

/* 规则 */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 20rpx;
}
.rule-sec-title {
  font-size: 26rpx;
  font-weight: 600;
  display: block;
  margin: 16rpx 0 8rpx;
}
.rule-cat-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  background: #f8f8f8;
  border-radius: var(--radius-sm);
  margin-bottom: 4rpx;
}
.rule-cat-name {
  font-size: 26rpx;
  font-weight: 500;
}
.rule-cat-count {
  font-size: 22rpx;
  color: var(--muted);
}
.rule-detail {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
}

/* 菜单 */
.menu-card {
  padding: 0;
}
.menu-row {
  display: flex;
  align-items: center;
  padding: 32rpx;
  gap: 16rpx;
}
.menu-icon {
  font-size: 36rpx;
}
.menu-text {
  font-size: 30rpx;
  font-weight: 500;
  flex: 1;
}
.menu-arrow {
  font-size: 28rpx;
  color: var(--muted);
}
.menu-desc {
  padding: 0 32rpx 24rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.version-text {
  text-align: center;
  padding: 40rpx 0;
  font-size: 22rpx;
  color: #ccc;
}
