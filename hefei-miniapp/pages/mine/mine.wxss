/* pages/mine/mine.wxss */
.page-container {
  padding: 24rpx 28rpx;
  padding-bottom: 80rpx;
}

/* 用户卡片 */
.user-card {
  text-align: center;
  position: relative;
  overflow: hidden;
  color: #fff;
  background: linear-gradient(135deg, var(--accent-start) 0%, var(--amber) 58%, var(--accent-end) 100%);
  box-shadow: 0 18rpx 42rpx var(--accent-shadow);
  padding-top: 38rpx;
}
.profile-sun {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,.12);
}
.profile-sun-a { width: 190rpx; height: 190rpx; right: -80rpx; top: -80rpx; }
.profile-sun-b { width: 110rpx; height: 110rpx; left: -45rpx; bottom: 20rpx; }
.profile-warmth {
  display: block;
  position: relative;
  color: rgba(255,255,255,.8);
  font-size: var(--font-xs);
  margin: -8rpx 0 24rpx;
}
.user-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.94);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-lg);
  box-shadow: 0 10rpx 24rpx var(--accent-shadow), inset 0 2rpx 0 rgba(255,255,255,0.8);
  position: relative;
}
.user-avatar image { width: 100%; height: 100%; border-radius: 50%; }
.avatar-actions { display: flex; align-items: center; justify-content: center; gap: 20rpx; margin: -8rpx 0 24rpx; position: relative; }
.avatar-reset { margin: 0; padding: 8rpx 0; background: transparent; color: rgba(255,255,255,.84); font-size: var(--font-xs); line-height: 1.4; }
.avatar-reset:after { border: 0; }
.theme-hint { display: block; color: var(--muted); font-size: var(--font-xs); margin-top: -10rpx; margin-bottom: 18rpx; }
.theme-options { display: flex; gap: 14rpx; }
.theme-option { flex: 1; display: flex; align-items: center; gap: 10rpx; padding: 18rpx; border: 2rpx solid var(--border); border-radius: 24rpx; font-size: var(--font-sm); background: var(--card); }
.theme-option.selected { border-color: var(--amber); box-shadow: 0 0 0 6rpx var(--amber-light); }
.theme-swatch { width: 32rpx; height: 32rpx; border-radius: 50%; flex-shrink: 0; }
.amber-swatch { background: #B86932; }
.mint-swatch { background: #2D9B7A; }
.theme-check { margin-left: auto; color: var(--amber); font-weight: 900; }
.user-info {
  text-align: left;
}
.user-name {
  font-size: var(--font-lg);
  font-weight: 600;
  display: block;
  color: #fff;
}
.user-role {
  font-size: var(--font-sm);
  color: rgba(255,255,255,.78);
}
.user-stats {
  display: flex;
  justify-content: center;
  gap: 0;
  border-top: 1rpx solid rgba(255,255,255,.24);
  padding-top: 20rpx;
}
.us-item {
  flex: 1;
}
.us-val {
  font-size: var(--font-lg);
  font-weight: 700;
  color: #fff;
  display: block;
}
.us-label {
  font-size: var(--font-xs);
  color: rgba(255,255,255,.76);
}
.us-val.score-total { font-size: var(--font-xl); }
.user-card .btn-outline { color: #fff; background: rgba(255,255,255,.14); border-color: rgba(255,255,255,.44); }

/* 提示 */
.hint-link {
  color: var(--amber);
  margin-left: 8rpx;
  font-weight: 500;
}

/* 规则 */
.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  display: block;
  margin-bottom: 20rpx;
}
.section-title.icon-heading,
.rule-sec-title.icon-heading { display: flex; }
.section-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: var(--amber-light);
  display: flex;
  align-items: center;
  justify-content: center;
}
.rule-summary-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid var(--border);
  background: linear-gradient(145deg, var(--card) 0%, var(--card) 70%, var(--amber-light) 140%);
  box-shadow: 0 12rpx 34rpx rgba(61,48,42,.07);
}
.rule-summary-card:after {
  content: '';
  position: absolute;
  width: 150rpx;
  height: 150rpx;
  right: -70rpx;
  top: -75rpx;
  border-radius: 50%;
  background: var(--amber-light);
  opacity: .65;
  pointer-events: none;
}
.rule-summary-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 82rpx;
}
.rule-summary-icon { flex: 0 0 56rpx; }
.rule-summary-copy { min-width: 0; flex: 1; }
.rule-summary-title {
  display: block;
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 800;
}
.rule-summary-intro {
  display: -webkit-box;
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: var(--font-xs);
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.rule-summary-arrow {
  width: 56rpx;
  flex: 0 0 56rpx;
  padding: 12rpx 0;
  color: var(--amber);
  font-size: var(--font-lg);
  font-weight: 700;
  text-align: right;
}
.rule-summary-total {
  display: block;
  margin: 22rpx 0 16rpx;
  color: var(--text);
  font-size: var(--font-sm);
  font-weight: 700;
  line-height: 1.5;
}
.rule-summary-stats {
  display: flex;
  gap: 12rpx;
}
.rule-summary-stat {
  min-width: 0;
  flex: 1;
  padding: 18rpx 8rpx;
  border-radius: var(--radius-sm);
  text-align: center;
}
.rule-summary-stat.reward { background: rgba(92,153,25,.09); }
.rule-summary-stat.punish { background: rgba(226,75,74,.08); }
.rule-summary-stat.special { background: var(--amber-light); }
.rule-summary-stat-value,
.rule-summary-stat-label { display: block; }
.rule-summary-stat-value {
  color: var(--text);
  font-size: var(--font-lg);
  font-weight: 850;
  line-height: 1.1;
}
.rule-summary-stat.reward .rule-summary-stat-value { color: var(--green); }
.rule-summary-stat.punish .rule-summary-stat-value { color: var(--red); }
.rule-summary-stat.special .rule-summary-stat-value { color: var(--amber); }
.rule-summary-stat-label {
  margin-top: 7rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: var(--font-xs);
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rule-summary-empty {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx dashed var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface-soft);
  text-align: center;
}
.rule-summary-empty-title,
.rule-summary-empty-copy { display: block; }
.rule-summary-empty-title { color: var(--text); font-size: var(--font-sm); font-weight: 750; }
.rule-summary-empty-copy { margin-top: 6rpx; color: var(--muted); font-size: var(--font-xs); line-height: 1.5; }
.rule-summary-actions {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}
.rule-summary-actions button { margin: 0; }
.rule-summary-primary { flex: 1; }
.rule-summary-admin { width: 196rpx; flex: 0 0 196rpx; }

/* 菜单 */
.menu-card {
  padding: 0;
}
.menu-row {
  display: flex;
  align-items: center;
  padding: 32rpx;
  gap: 16rpx;
}
.menu-icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  background: var(--amber-light);
  display: flex;
  align-items: center;
  justify-content: center;
}
.menu-text {
  font-size: var(--font-md);
  font-weight: 500;
  flex: 1;
}
.menu-arrow {
  font-size: var(--font-md);
  color: var(--muted);
}
.menu-desc {
  padding: 0 32rpx 24rpx;
  font-size: var(--font-sm);
  color: var(--muted);
}

.app-footer {
  text-align: center;
  padding: 44rpx 0 24rpx;
}
.version-text,
.filing-text {
  display: block;
  font-size: var(--font-xs);
  line-height: 1.8;
  color: var(--muted);
}
.filing-text {
  font-size: var(--font-xs);
  opacity: .78;
}
