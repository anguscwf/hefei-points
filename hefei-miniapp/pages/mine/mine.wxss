/* pages/mine/mine.wxss */
.page-container {
  padding: 24rpx 28rpx;
  padding-bottom: 80rpx;
}

/* 用户卡片 */
.user-card {
  text-align: center;
  position: relative;
  overflow: hidden;
  color: #fff;
  background: linear-gradient(135deg, var(--accent-start) 0%, var(--amber) 58%, var(--accent-end) 100%);
  box-shadow: 0 18rpx 42rpx var(--accent-shadow);
  padding-top: 38rpx;
}
.profile-sun {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,.12);
}
.profile-sun-a { width: 190rpx; height: 190rpx; right: -80rpx; top: -80rpx; }
.profile-sun-b { width: 110rpx; height: 110rpx; left: -45rpx; bottom: 20rpx; }
.profile-warmth {
  display: block;
  position: relative;
  color: rgba(255,255,255,.8);
  font-size: var(--font-xs);
  margin: -8rpx 0 24rpx;
}
.user-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.94);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-lg);
  box-shadow: 0 10rpx 24rpx var(--accent-shadow), inset 0 2rpx 0 rgba(255,255,255,0.8);
  position: relative;
}
.user-avatar image { width: 100%; height: 100%; border-radius: 50%; }
.avatar-actions { display: flex; align-items: center; justify-content: center; gap: 20rpx; margin: -8rpx 0 24rpx; position: relative; }
.avatar-reset { margin: 0; padding: 8rpx 0; background: transparent; color: rgba(255,255,255,.84); font-size: var(--font-xs); line-height: 1.4; }
.avatar-reset:after { border: 0; }
.theme-hint { display: block; color: var(--muted); font-size: var(--font-xs); margin-top: -10rpx; margin-bottom: 18rpx; }
.theme-options { display: flex; gap: 14rpx; }
.theme-option { flex: 1; display: flex; align-items: center; gap: 10rpx; padding: 18rpx; border: 2rpx solid var(--border); border-radius: 24rpx; font-size: var(--font-sm); background: var(--card); }
.theme-option.selected { border-color: var(--amber); box-shadow: 0 0 0 6rpx var(--amber-light); }
.theme-swatch { width: 32rpx; height: 32rpx; border-radius: 50%; flex-shrink: 0; }
.amber-swatch { background: #B86932; }
.mint-swatch { background: #2D9B7A; }
.theme-check { margin-left: auto; color: var(--amber); font-weight: 900; }
.user-info {
  text-align: left;
}
.user-name {
  font-size: var(--font-lg);
  font-weight: 600;
  display: block;
  color: #fff;
}
.user-role {
  font-size: var(--font-sm);
  color: rgba(255,255,255,.78);
}
.user-stats {
  display: flex;
  justify-content: center;
  gap: 0;
  border-top: 1rpx solid rgba(255,255,255,.24);
  padding-top: 20rpx;
}
.us-item {
  flex: 1;
}
.us-val {
  font-size: var(--font-lg);
  font-weight: 700;
  color: #fff;
  display: block;
}
.us-label {
  font-size: var(--font-xs);
  color: rgba(255,255,255,.76);
}
.us-val.score-total { font-size: var(--font-xl); }
.user-card .btn-outline { color: #fff; background: rgba(255,255,255,.14); border-color: rgba(255,255,255,.44); }

/* 提示 */
.hint-link {
  color: var(--amber);
  margin-left: 8rpx;
  font-weight: 500;
}

/* 规则 */
.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  display: block;
  margin-bottom: 20rpx;
}
.section-title.icon-heading,
.rule-sec-title.icon-heading { display: flex; }
.section-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: var(--amber-light);
  display: flex;
  align-items: center;
  justify-content: center;
}
.rule-sec-title {
  font-size: var(--font-sm);
  font-weight: 600;
  display: block;
  margin: 16rpx 0 8rpx;
}
.rule-cat-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  background: var(--surface-soft);
  border-radius: var(--radius-sm);
  margin-bottom: 4rpx;
}
.rule-cat-name {
  font-size: var(--font-sm);
  font-weight: 500;
}
.rule-cat-count {
  font-size: var(--font-xs);
  color: var(--muted);
}
.rule-detail {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 24rpx;
  font-size: var(--font-sm);
}

/* 菜单 */
.menu-card {
  padding: 0;
}
.menu-row {
  display: flex;
  align-items: center;
  padding: 32rpx;
  gap: 16rpx;
}
.menu-icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  background: var(--amber-light);
  display: flex;
  align-items: center;
  justify-content: center;
}
.menu-text {
  font-size: var(--font-md);
  font-weight: 500;
  flex: 1;
}
.menu-arrow {
  font-size: var(--font-md);
  color: var(--muted);
}
.menu-desc {
  padding: 0 32rpx 24rpx;
  font-size: var(--font-sm);
  color: var(--muted);
}

.app-footer {
  text-align: center;
  padding: 44rpx 0 24rpx;
}
.version-text,
.filing-text {
  display: block;
  font-size: var(--font-xs);
  line-height: 1.8;
  color: var(--muted);
}
.filing-text {
  font-size: var(--font-xs);
  opacity: .78;
}
