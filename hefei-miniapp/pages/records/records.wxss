/* pages/records/records.wxss */
.page-container {
  padding: 24rpx 28rpx;
  padding-bottom: 40rpx;
}
.records-hero {
  padding: 30rpx 32rpx;
  margin-bottom: 22rpx;
  border-radius: 38rpx;
  color: #fff;
  background: linear-gradient(135deg, var(--accent-start) 0%, var(--amber) 58%, var(--accent-end) 100%);
  border: 1rpx solid var(--border);
  box-shadow: 0 18rpx 42rpx var(--accent-shadow);
}
.records-hero-kicker { display: block; color: rgba(255,255,255,.72); font-size: var(--font-xs); font-weight: 700; letter-spacing: 4rpx; }
.records-hero-title { display: block; color: #fff; font-size: var(--font-lg); font-weight: 800; margin: 8rpx 0 5rpx; }
.records-hero-sub { display: block; color: rgba(255,255,255,.8); font-size: var(--font-xs); }

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.filter-tab {
  padding: 16rpx 32rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  font-weight: 500;
  background: var(--card);
  color: var(--muted);
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-sm);
}
.filter-tab.active {
  background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
  color: #fff;
  font-weight: 600;
}

/* 记录列表 */
.month-group {
  margin-bottom: 32rpx;
}
.month-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--muted);
  display: block;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.history-item {
  background: var(--card);
  border-radius: var(--radius-sm);
  padding: 18rpx 20rpx;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-sm);
  border-left: 6rpx solid #ccc;
}
.history-item:active {
  animation: tapBounce .25s ease-out;
}
.hi-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.hi-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  color: var(--muted);
  font-size: var(--font-xs);
}
.hi-kid {
  font-weight: 600;
  font-size: var(--font-sm);
  white-space: nowrap;
}
.hi-amount {
  font-weight: 700;
  font-size: var(--font-md);
  white-space: nowrap;
}
.hi-amount.plus { color: var(--green); }
.hi-amount.minus { color: var(--red); }
.hi-reason {
  font-size: var(--font-sm);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hi-note {
  font-size: var(--font-sm);
  color: var(--amber);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 200rpx;
  flex-shrink: 1;
}
.hi-op, .hi-time {
  white-space: nowrap;
}
