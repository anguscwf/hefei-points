/* pages/records/records.wxss */
.page-container {
  padding: 24rpx 28rpx;
  padding-bottom: 40rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.filter-tab {
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  background: #f0f0f0;
  color: #666;
}
.filter-tab.active {
  background: var(--amber);
  color: #fff;
  font-weight: 600;
}

/* 记录列表 */
.month-group {
  margin-bottom: 32rpx;
}
.month-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--muted);
  display: block;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.history-item {
  background: var(--card);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 6rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.04);
  border-left: 6rpx solid #ccc;
}
.history-item:active {
  background: #fafafa;
  transform: scale(0.99);
}
.hi-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.hi-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  color: var(--muted);
  font-size: 22rpx;
}
.hi-kid {
  font-weight: 600;
  font-size: 26rpx;
  white-space: nowrap;
}
.hi-amount {
  font-weight: 700;
  font-size: 28rpx;
  white-space: nowrap;
}
.hi-amount.plus { color: var(--green); }
.hi-amount.minus { color: var(--red); }
.hi-reason {
  font-size: 26rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hi-note {
  font-size: 24rpx;
  color: var(--amber);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 200rpx;
  flex-shrink: 1;
}
.hi-op, .hi-time {
  white-space: nowrap;
}
