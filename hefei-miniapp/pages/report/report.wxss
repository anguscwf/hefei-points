/* pages/report/report.wxss */
.page-container {
  padding: 24rpx 28rpx;
  padding-bottom: 80rpx;
}

/* 筛选 */
.filter-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}
.filter-label {
  font-size: 22rpx;
  color: #666;
  font-weight: 600;
  min-width: 56rpx;
  line-height: 44rpx;
}
.filter-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  flex: 1;
}
.filter-btn {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  background: #f0f0f0;
  color: #666;
}
.filter-btn.active {
  background: var(--amber);
  color: #fff;
  font-weight: 600;
}
.custom-date-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}
.date-pick {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  background: var(--card);
  display: inline-block;
}
.date-sep {
  font-size: 22rpx;
  color: var(--muted);
}

/* 总结 */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  display: block;
  margin-bottom: 20rpx;
}
.summary-table {
  width: 100%;
}
.summary-header, .summary-row {
  display: flex;
}
.st-cell {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 8rpx 0;
}
.summary-header {
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

/* Canvas */
.chart-canvas {
  width: 100%;
  height: 440rpx;
  margin: 16rpx 0;
}
.pie-canvas {
  height: 420rpx;
}

/* Top 10 */
.top-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 26rpx;
}
.top-amount {
  font-weight: 500;
  min-width: 72rpx;
}
.top-reason {
  flex: 1;
}
.top-meta {
  font-size: 22rpx;
  color: var(--muted);
}
