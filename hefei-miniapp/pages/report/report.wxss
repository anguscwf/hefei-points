/* pages/report/report.wxss */
.page-container {
  padding: 24rpx 28rpx;
  padding-bottom: 80rpx;
}
.report-hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 32rpx;
  margin-bottom: 22rpx;
  border-radius: 40rpx;
  color: #fff;
  background: linear-gradient(135deg, var(--accent-start) 0%, var(--amber) 58%, var(--accent-end) 100%);
  box-shadow: 0 18rpx 42rpx var(--accent-shadow);
}
.report-hero:after {
  content: '';
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
  right: -90rpx;
  top: -120rpx;
}
.report-eyebrow { display: block; font-size: var(--font-xs); letter-spacing: 4rpx; color: rgba(255,255,255,0.68); }
.report-title { display: block; font-size: var(--font-lg); font-weight: 800; line-height: 1.45; margin: 10rpx 0 6rpx; max-width: 540rpx; }
.report-subtitle { display: block; font-size: var(--font-xs); color: rgba(255,255,255,0.78); }

/* 筛选 */
.filter-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}
.filter-label {
  font-size: var(--font-xs);
  color: #666;
  font-weight: 600;
  min-width: 56rpx;
  line-height: 44rpx;
}
.filter-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  flex: 1;
}
.filter-btn {
  font-size: var(--font-xs);
  padding: 6rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--surface-soft);
  color: var(--muted);
  border: 1rpx solid var(--border);
}
.filter-btn.active {
  background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
  color: #fff;
  font-weight: 600;
}
.filter-btn:active { animation: tapBounce .25s ease-out; }
.custom-date-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}
.date-pick {
  font-size: var(--font-xs);
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--card);
  display: inline-block;
}
.date-sep {
  font-size: var(--font-xs);
  color: var(--muted);
}

/* 总结 */
.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  text-align: center;
  display: block;
  margin-bottom: 20rpx;
}
.section-title.icon-heading { display: flex; }
.ranking-title { justify-content: center; }
.summary-table {
  width: 100%;
}
.summary-header, .summary-row {
  display: flex;
}
.st-cell {
  flex: 1;
  text-align: center;
  font-size: var(--font-sm);
  padding: 8rpx 0;
}
.summary-header {
  border-bottom: 1rpx solid var(--border);
  margin-bottom: 8rpx;
  font-size: var(--font-xs);
  color: var(--muted);
}
.summary-row {
  padding: 10rpx 0;
  border-radius: var(--radius-sm);
  background: var(--surface-soft);
  margin-top: 8rpx;
}
.insight-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  background: linear-gradient(135deg, var(--card), var(--surface-soft));
  border: 1rpx solid var(--border);
}
.insight-icon {
  width: 66rpx;
  height: 66rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-lg);
  background: var(--card);
  box-shadow: var(--shadow-sm);
  flex-shrink: 0;
}
.insight-copy { flex: 1; }
.insight-title { display: block; color: var(--amber-dark); font-size: var(--font-sm); font-weight: 700; margin-bottom: 6rpx; }
.insight-text { display: block; color: var(--text); font-size: var(--font-sm); line-height: 1.65; }
.insight-privacy { display: block; color: var(--muted); font-size: var(--font-xs); margin-top: 10rpx; }
.ranking-card { padding: 24rpx 28rpx; }
.ranking-row { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 20rpx; margin-top: 10rpx; border-radius: var(--radius-sm); background: var(--surface-soft); }
.ranking-row.rank-1 { background: linear-gradient(120deg, var(--amber-light), var(--card)); }
.ranking-medal { width: 54rpx; display: flex; align-items: center; justify-content: center; }
.ranking-name { flex: 1; font-size: var(--font-sm); font-weight: 700; }
.ranking-score { color: var(--green); font-size: var(--font-sm); font-weight: 800; display: flex; align-items: center; gap: 7rpx; }
.month-card { background: linear-gradient(135deg, var(--card), var(--surface-soft)); }
.month-head { display: flex; align-items: center; justify-content: space-between; }
.month-head .section-title { margin-bottom: 0; text-align: left; }
.month-trend { font-size: var(--font-xs); font-weight: 700; padding: 8rpx 14rpx; border-radius: 18rpx; background: rgba(143,129,120,.1); }
.month-trend.up { color: var(--green); background: rgba(92,153,25,.1); }
.month-trend.down { color: var(--red); background: rgba(226,75,74,.1); }
.month-values { display: flex; align-items: center; text-align: center; margin-top: 24rpx; }
.month-values > view:not(.month-divider) { flex: 1; }
.month-value { display: block; color: var(--amber); font-size: var(--font-lg); font-weight: 900; }
.month-value.muted { color: var(--muted); }
.month-label { display: block; color: var(--muted); font-size: var(--font-xs); margin-top: 5rpx; }
.month-divider { width: 1rpx; height: 68rpx; background: var(--border); }

/* Canvas */
.chart-canvas {
  width: 100%;
  height: 440rpx;
  margin: 16rpx 0;
}
.pie-canvas {
  height: 420rpx;
}
.chart-preview-placeholder { visibility: hidden; }

/* Top 10 */
.top-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border);
  font-size: var(--font-sm);
}
.top-amount {
  font-weight: 500;
  min-width: 72rpx;
}
.top-reason {
  flex: 1;
}
.top-meta {
  font-size: var(--font-xs);
  color: var(--muted);
}

/* ===== v2.2 成长数据模块 ===== */
.growth-overview-card {
  overflow: hidden;
  background: linear-gradient(145deg, var(--card), var(--surface-soft));
}
.growth-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.growth-section-title {
  justify-content: flex-start;
  margin-bottom: 0;
  text-align: left;
}
.growth-section-note,
.growth-range-chip {
  flex-shrink: 0;
  color: var(--muted);
  font-size: var(--font-xs);
}
.growth-range-chip {
  padding: 7rpx 14rpx;
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  color: var(--amber);
  background: var(--amber-light);
}
.growth-stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}
.growth-stat-item {
  position: relative;
  overflow: hidden;
  padding: 22rpx 20rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: rgba(255,255,255,.64);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,.9);
}
.growth-stat-item:after {
  content: '';
  position: absolute;
  right: -20rpx;
  bottom: -34rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: currentColor;
  opacity: .07;
}
.growth-stat-number {
  display: flex;
  align-items: baseline;
  gap: 5rpx;
  color: var(--amber);
  font-size: var(--font-lg);
  font-weight: 900;
  line-height: 1.1;
}
.tone-positive .growth-stat-number { color: var(--green); }
.tone-negative .growth-stat-number { color: var(--red); }
.tone-blue .growth-stat-number { color: var(--blue); }
.growth-stat-unit { font-size: var(--font-xs); font-weight: 700; }
.growth-stat-label { display: block; margin-top: 8rpx; color: var(--muted); font-size: var(--font-xs); }

.streak-list { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.streak-kid {
  padding: 20rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: linear-gradient(145deg, rgba(255,255,255,.82), var(--surface-soft));
}
.streak-kid-head { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }
.streak-kid-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--font-sm); font-weight: 800; }
.streak-active { flex-shrink: 0; color: var(--muted); font-size: var(--font-xs); }
.streak-values { display: flex; align-items: center; margin-top: 18rpx; text-align: center; }
.streak-values > view:not(.streak-divider) { flex: 1; min-width: 0; }
.streak-number { color: var(--amber); font-size: var(--font-lg); font-weight: 900; }
.streak-number.best { color: var(--green); }
.streak-unit { margin-left: 3rpx; color: var(--muted); font-size: var(--font-xs); }
.streak-label { display: block; margin-top: 4rpx; color: var(--muted); font-size: var(--font-xs); }
.streak-divider { width: 1rpx; height: 60rpx; background: var(--border); }

.habit-highlight {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
  padding: 18rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface-soft);
}
.habit-rank-dot {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  color: #fff;
  background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
  font-size: var(--font-xs);
  font-weight: 800;
}
.habit-main { flex: 1; min-width: 0; }
.habit-kid { display: block; color: var(--muted); font-size: var(--font-xs); }
.habit-reason { display: block; overflow: hidden; margin-top: 2rpx; color: var(--text); font-size: var(--font-sm); font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.habit-trend { display: block; margin-top: 5rpx; color: var(--amber); font-size: var(--font-xs); }
.habit-score { flex-shrink: 0; text-align: right; }
.habit-count { display: block; color: var(--green); font-size: var(--font-md); font-weight: 900; }
.habit-points { display: block; margin-top: 3rpx; color: var(--muted); font-size: var(--font-xs); }

.stage-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 14rpx;
  padding: 20rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, var(--card), var(--surface-soft));
}
.stage-medal { width: 68rpx; flex: 0 0 68rpx; display: flex; align-items: center; justify-content: center; }
.stage-main { flex: 1; min-width: 0; }
.stage-title-row { display: flex; align-items: baseline; gap: 12rpx; }
.stage-kid { min-width: 0; overflow: hidden; color: var(--text); font-size: var(--font-sm); font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.stage-title { flex-shrink: 0; color: var(--amber); font-size: var(--font-xs); font-weight: 800; }
.stage-progress { height: 12rpx; overflow: hidden; margin: 13rpx 0 8rpx; border-radius: 999rpx; background: rgba(143,129,120,.14); }
.stage-progress-fill { height: 100%; min-width: 8rpx; border-radius: 999rpx; background: linear-gradient(90deg, var(--honey), var(--amber)); }
.stage-next { display: block; color: var(--muted); font-size: var(--font-xs); line-height: 1.45; }
.stage-badges { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.stage-badge-chip { padding: 5rpx 10rpx; border-radius: 999rpx; color: var(--amber-dark); background: var(--amber-light); font-size: var(--font-xs); }

.encouragement-card {
  position: relative;
  overflow: hidden;
  padding: 34rpx 32rpx;
  border-color: rgba(243,184,91,.28);
  background: linear-gradient(145deg, var(--amber-light), var(--card));
}
.encouragement-card:after {
  content: '“';
  position: absolute;
  right: 22rpx;
  top: -34rpx;
  color: var(--amber);
  font-size: 160rpx;
  font-weight: 900;
  opacity: .09;
}
.encouragement-spark { position: absolute; right: 28rpx; bottom: 24rpx; opacity: .28; }
.encouragement-kicker { display: block; color: var(--amber); font-size: var(--font-xs); font-weight: 800; letter-spacing: 2rpx; }
.encouragement-title { display: block; margin-top: 10rpx; color: var(--text); font-size: var(--font-md); font-weight: 900; }
.encouragement-text { display: block; max-width: 590rpx; margin-top: 16rpx; color: var(--text); font-size: var(--font-sm); line-height: 1.75; }
.encouragement-sign { display: block; margin-top: 16rpx; color: var(--muted); font-size: var(--font-xs); text-align: right; }

/* ===== 独立分享预览层：纯色卡片 + 卸载背景 Canvas，杜绝混叠 ===== */
.share-canvas-offscreen {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 750rpx;
  height: 1380rpx;
  pointer-events: none;
}
.share-preview-overlay {
  z-index: 1000;
  padding: 34rpx;
  box-sizing: border-box;
  background: rgba(15,29,25,.86);
}
.share-preview-dialog {
  width: 620rpx;
  max-width: 90vw;
  max-height: 88vh;
  padding: 30rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255,255,255,.72);
  background: #FFFDF9;
  box-shadow: 0 34rpx 90rpx rgba(5,20,16,.35);
  opacity: 1;
}
.theme-mint .share-preview-dialog { background: #FBFFFD; }
.share-preview-frame {
  overflow: hidden;
  margin: 18rpx 0 14rpx;
  padding: 10rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  background: #fff;
  box-shadow: 0 14rpx 38rpx rgba(32,73,61,.14);
}
.share-preview {
  display: block;
  width: 100%;
  margin: 0;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: none;
}
