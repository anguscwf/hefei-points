/* pages/index/index.wxss */
.page-container {
  padding: 24rpx 28rpx;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* ===== Header ===== */
.header {
  color: #fff;
  background: linear-gradient(135deg, var(--accent-start) 0%, var(--amber) 58%, var(--accent-end) 100%);
  padding: 34rpx 30rpx 30rpx;
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
  text-align: left;
  position: relative;
  display: block;
  overflow: hidden;
  box-shadow: 0 20rpx 44rpx var(--accent-shadow), inset 0 1rpx 0 rgba(255,255,255,0.26);
}
.hero-glow {
  position: absolute;
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.12);
}
.hero-glow-a { right: -80rpx; top: -110rpx; }
.hero-glow-b { left: -100rpx; bottom: -170rpx; }
.brand-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.brand-mark {
  width: 92rpx;
  height: 92rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.22);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.5), 0 8rpx 18rpx rgba(80,37,15,0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}
.brand-copy { display: flex; flex-direction: column; gap: 5rpx; }
.brand-title { color: #fff; font-size: var(--font-lg); line-height: 1.1; font-weight: 800; letter-spacing: 2rpx; }
.brand-subtitle { color: rgba(255,255,255,0.82); font-size: var(--font-xs); }
.login-welcome {
  background: var(--card);
  backdrop-filter: blur(18rpx);
}
.welcome-card {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 62rpx 42rpx 42rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(145deg, var(--accent-start), var(--accent-end));
  color: #fff;
  box-shadow: 0 22rpx 52rpx var(--accent-shadow);
}
.welcome-orbit {
  position: absolute;
  border: 2rpx solid rgba(255,255,255,.16);
  border-radius: 50%;
}
.welcome-orbit-a { width: 360rpx; height: 360rpx; right: -190rpx; top: -170rpx; }
.welcome-orbit-b { width: 220rpx; height: 220rpx; left: -120rpx; bottom: -100rpx; }
.welcome-logo {
  position: relative;
  width: 148rpx;
  height: 148rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.92);
  box-shadow: 0 14rpx 30rpx rgba(14,67,51,.24), 0 0 0 10rpx rgba(255,255,255,.12);
  display: flex;
  align-items: center;
  justify-content: center;
}
.welcome-title { position: relative; font-size: var(--font-lg); font-weight: 800; }
.welcome-subtitle { position: relative; margin: 12rpx 0 34rpx; font-size: var(--font-xs); color: rgba(255,255,255,.84); }
.wx-login-btn {
  position: relative;
  width: 100%;
  padding: 20rpx;
  font-size: var(--font-md);
  border-radius: var(--radius);
  color: var(--amber-dark);
  background: #fff;
  box-shadow: 0 10rpx 24rpx rgba(10,55,42,.18);
}
.wx-login-btn[disabled] {
  color: var(--amber-dark);
  opacity: .76;
}
.login-guide-link { position: relative; margin-top: 24rpx; font-size: var(--font-xs); color: rgba(255,255,255,.82); text-decoration: underline; }
.backup-login { margin-bottom: 22rpx; }
.login-divider { display: flex; align-items: center; gap: 18rpx; margin: 8rpx 12rpx 18rpx; color: var(--muted); font-size: var(--font-xs); }
.login-divider view { flex: 1; height: 1rpx; background: var(--border); }
.backup-login .login-bar { margin-bottom: 0; }
.header-status {
  font-size: var(--font-sm);
  font-weight: 500;
  color: rgba(255,255,255,0.82);
  display: block;
  text-align: left;
  line-height: 1.2;
  margin: 18rpx 0 0 112rpx;
  position: relative;
  z-index: 1;
}
.refresh-btn {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255,255,255,0.15);
  border: none;
  color: #fff;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  font-size: var(--font-lg);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 登录栏 ===== */
.login-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.logout-bar {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: var(--radius);
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  justify-content: flex-start;
  gap: 10rpx;
}
.user-picker {
  flex: 1;
}
.picker-display {
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  background: var(--card);
}
.pwd-input {
  flex: 2;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
}
.uid-input {
  flex: 1;
  min-width: 0;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--card);
  font-size: var(--font-md);
}
.logged-hint {
  flex: 0 0 auto;
  font-size: var(--font-md);
  color: var(--muted);
  white-space: nowrap;
}
.icon-only-btn {
  width: 76rpx;
  min-width: 76rpx;
  padding-left: 0;
  padding-right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-hint { display: flex; align-items: center; justify-content: center; gap: 14rpx; }
.loading-dot {
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--amber);
  border-radius: 50%;
  animation: loadingSpin .8s linear infinite;
}

/* ===== 积分卡片 ===== */
.kid-switcher {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  gap: 30rpx;
  padding: 8rpx 10rpx 22rpx;
}
.kid-switch-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  color: var(--muted);
  transition: transform .25s ease;
}
.kid-switch-avatar {
  width: 76rpx;
  height: 76rpx;
  border: 4rpx solid;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  font-size: var(--font-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: box-shadow .25s ease, transform .25s ease;
}
.kid-switch-avatar image { width: 100%; height: 100%; }
.kid-switch-name { font-size: var(--font-xs); }
.kid-switch-item.selected { color: var(--amber); font-weight: 700; transform: translateY(-4rpx) scale(1.08); }
.kid-switch-item.selected .kid-switch-avatar {
  box-shadow: 0 0 0 10rpx var(--amber-light), 0 12rpx 26rpx var(--accent-shadow);
}
.score-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
  margin: 18rpx 0 24rpx;
}
.score-card {
  position: relative;
  background: linear-gradient(145deg, rgba(255,255,255,.62), rgba(255,255,255,.16));
  border: 2rpx solid rgba(255,255,255,.78);
  border-radius: 54rpx;
  padding: 0 7rpx 9rpx;
  display: flex;
  flex-direction: column;
  height: 488rpx;
  box-sizing: border-box;
  align-items: center;
  box-shadow: 0 18rpx 34rpx rgba(43,82,69,.11), inset 0 2rpx 0 rgba(255,255,255,.86);
}
.kid-card-avatar {
  width: 62rpx;
  height: 62rpx;
  flex: 0 0 62rpx;
  border: 3rpx solid var(--jar-accent);
  border-radius: 50%;
  background: linear-gradient(150deg, #fff, var(--jar-soft));
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 6rpx 14rpx rgba(45,64,58,.12), inset 0 2rpx 0 #fff;
  font-size: var(--font-md);
  box-sizing: border-box;
}
.kid-card-avatar image { width: 100%; height: 100%; }
.score-card:active {
  animation: jarWiggle 0.36s ease-out;
}
.score-card-child:active {
  transform: none;
}
.card-name {
  display: block;
  font-size: var(--font-md);
  font-weight: 800;
  color: var(--text);
  line-height: 1.15;
}
.jar-label {
  position: relative;
  z-index: 3;
  width: 78%;
  margin: 0 auto 6rpx;
  padding: 10rpx 13rpx;
  border: 3rpx solid var(--jar-accent);
  border-radius: 27rpx;
  background: linear-gradient(150deg, rgba(255,255,255,.98), rgba(255,255,255,.86));
  box-shadow: inset 0 2rpx 0 #fff, 0 8rpx 18rpx rgba(61,48,42,.1);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
}
.jar-label-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
}
.jar-label-eyebrow {
  display: block;
  margin-bottom: 2rpx;
  color: var(--muted);
  font-size: var(--font-xs);
  font-weight: 700;
  letter-spacing: 1rpx;
}
.score-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 3;
  flex: 1;
  width: 100%;
  min-height: 106rpx;
  padding: 0;
  overflow: hidden;
}
.score-number-core {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.score-sign {
  position: absolute;
  right: calc(100% + 6rpx);
  top: 50%;
  transform: translateY(-50%);
  font-size: var(--font-score-sign);
  font-weight: 800;
  line-height: 1;
}
.score-num {
  display: inline-block;
  font-size: var(--font-score);
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  text-shadow: 0 3rpx 0 rgba(255,255,255,.78), 0 10rpx 22rpx rgba(45,64,58,.12);
}
.score-num-medium { font-size: var(--font-score-4d); letter-spacing: -1rpx; }
.score-num-long { font-size: var(--font-score-5d); letter-spacing: -1rpx; }
.score-num-xlong { font-size: var(--font-score-6d); letter-spacing: -1rpx; }
.score-num-xxlong { font-size: var(--font-score-7d); letter-spacing: -1rpx; }
.score-num-ultralong { font-size: var(--font-score-9d); letter-spacing: -1rpx; }
.score-number-core.score-num-ultralong .score-sign { font-size: var(--font-score-9d); }
.card-hint {
  position: relative;
  z-index: 3;
  font-size: var(--font-xs);
  color: var(--muted);
  text-align: center;
  margin-top: 2rpx;
}
.family-note {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 22rpx;
  border-radius: var(--radius);
  background: linear-gradient(125deg, var(--card), var(--surface-soft));
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-sm);
}
.family-note-icon {
  width: 70rpx;
  height: 70rpx;
  border-radius: 24rpx;
  background: var(--amber-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.family-note-title { display: block; font-size: var(--font-sm); color: var(--text); font-weight: 700; }
.family-note-sub { display: block; font-size: var(--font-xs); color: var(--muted); margin-top: 4rpx; }

/* ===== Tab 切换 ===== */
.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.tab {
  flex: 1;
  padding: 22rpx 16rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--border);
  background: var(--card);
  font-size: var(--font-md);
  font-weight: 500;
  text-align: center;
}
.tab.active {
  background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
  color: #fff;
  border-color: var(--amber);
  box-shadow: 0 4rpx 16rpx var(--accent-shadow);
}
.tab-link { color: var(--amber); font-weight: 600; }

.tab-content {
  animation: fadeIn 0.25s ease-out;
}

/* ===== 积分记录 ===== */
.history-item {
  background: var(--card);
  border-radius: var(--radius-sm);
  padding: 14rpx 20rpx;
  margin-bottom: 6rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.04);
  border-left: 6rpx solid #ccc;
}
.history-item:active {
  background: var(--bg);
  transform: scale(0.99);
}
.hi-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.hi-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  color: var(--muted);
  font-size: var(--font-xs);
}
.hi-kid {
  font-weight: 600;
  font-size: var(--font-sm);
  white-space: nowrap;
}
.hi-amount {
  font-weight: 700;
  font-size: var(--font-md);
  white-space: nowrap;
}
.hi-amount.plus { color: var(--green); }
.hi-amount.minus { color: var(--red); }
.hi-reason {
  font-size: var(--font-sm);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hi-note {
  font-size: var(--font-sm);
  color: var(--amber);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 200rpx;
  flex-shrink: 1;
}
.hi-op, .hi-time {
  white-space: nowrap;
}

/* ===== 规则 ===== */
.rule-center { padding-bottom: 12rpx; }
.rule-center-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  background: linear-gradient(135deg, var(--card), var(--amber-light));
  box-shadow: 0 12rpx 30rpx var(--accent-shadow);
}
.rule-center-hero-icon {
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: rgba(255,255,255,.72);
  box-shadow: inset 0 0 0 1rpx rgba(255,255,255,.86);
}
.rule-center-hero-copy { min-width: 0; }
.rule-center-title {
  display: block;
  color: var(--text);
  font-size: var(--font-lg);
  font-weight: 800;
  line-height: 1.25;
}
.rule-center-intro,
.rule-center-count {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: var(--font-xs);
  line-height: 1.55;
}
.rule-center-count { color: var(--amber); font-weight: 700; }
.rule-search-box {
  min-height: 82rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--border);
  border-radius: 26rpx;
  background: var(--card);
  box-shadow: 0 8rpx 22rpx rgba(61,48,42,.06);
  box-sizing: border-box;
}
.rule-search-input {
  min-width: 0;
  height: 82rpx;
  flex: 1;
  color: var(--text);
  font-size: var(--font-sm);
}
.rule-search-glyph {
  position: relative;
  width: 23rpx;
  height: 23rpx;
  flex: 0 0 23rpx;
  border: 4rpx solid var(--amber);
  border-radius: 50%;
  box-sizing: border-box;
}
.rule-search-glyph:after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 4rpx;
  right: -10rpx;
  bottom: -5rpx;
  border-radius: 999rpx;
  background: var(--amber);
  transform: rotate(45deg);
  transform-origin: left center;
}
.rule-search-clear {
  padding: 18rpx 4rpx;
  color: var(--amber);
  font-size: var(--font-xs);
  font-weight: 700;
}
.rule-filter-scroll { width: 100%; margin: 18rpx 0; white-space: nowrap; }
.rule-filter-row { display: inline-flex; gap: 12rpx; padding: 2rpx 4rpx 8rpx; }
.rule-filter-chip {
  min-width: 112rpx;
  padding: 16rpx 22rpx;
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  background: var(--card);
  color: var(--muted);
  font-size: var(--font-sm);
  text-align: center;
  box-sizing: border-box;
}
.rule-filter-chip.active {
  border-color: transparent;
  background: var(--amber);
  color: #fff;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx var(--accent-shadow);
}
.rule-center-guide {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: -2rpx 0 16rpx;
  padding: 10rpx 16rpx;
  border-radius: var(--radius-sm);
  background: var(--surface-soft);
  color: var(--muted);
  font-size: var(--font-xs);
  line-height: 1.45;
  box-sizing: border-box;
}
.frequent-rules-card,
.rule-category-card,
.family-agreement-card {
  margin-bottom: 16rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  background: var(--card);
  box-shadow: 0 10rpx 28rpx rgba(61,48,42,.06);
  overflow: hidden;
}
.frequent-rules-card,
.family-agreement-card { padding: 24rpx; }
.rule-block-heading,
.rule-category-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.rule-block-title {
  display: block;
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 800;
}
.rule-block-sub {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: var(--font-xs);
  line-height: 1.45;
}
.rule-block-badge,
.rule-category-count {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: var(--amber-light);
  color: var(--amber);
  font-size: var(--font-xs);
  font-weight: 700;
}
.frequent-rule-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.frequent-rule-item {
  width: calc(50% - 6rpx);
  min-height: 116rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx;
  border-radius: var(--radius-sm);
  background: var(--surface-soft);
  box-sizing: border-box;
}
.frequent-rule-item.reward { border-left: 5rpx solid var(--green); }
.frequent-rule-item.punish { border-left: 5rpx solid var(--red); }
.frequent-rule-copy { min-width: 0; flex: 1; }
.frequent-rule-label,
.frequent-rule-category {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
}
.frequent-rule-label {
  color: var(--text);
  font-size: var(--font-sm);
  font-weight: 700;
  white-space: nowrap;
}
.frequent-rule-category {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: var(--font-xs);
  white-space: nowrap;
}
.rule-default-pill {
  flex-shrink: 0;
  max-width: 150rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  font-size: var(--font-xs);
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rule-default-pill.reward { color: var(--green); background: rgba(92,153,25,.10); }
.rule-default-pill.punish { color: var(--red); background: rgba(226,75,74,.09); }
.rule-category-card.reward { border-left: 6rpx solid var(--green); }
.rule-category-card.punish { border-left: 6rpx solid var(--red); }
.rule-category-head {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx;
  box-sizing: border-box;
}
.rule-category-icon {
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 19rpx;
}
.rule-category-icon.reward { background: rgba(92,153,25,.10); }
.rule-category-icon.punish { background: rgba(226,75,74,.09); }
.rule-category-copy { min-width: 0; flex: 1; }
.rule-category-title-row { justify-content: flex-start; }
.rule-category-title {
  min-width: 0;
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 800;
  overflow-wrap: anywhere;
}
.rule-category-preview {
  display: block;
  max-width: 440rpx;
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: var(--font-xs);
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rule-category-toggle {
  min-width: 94rpx;
  flex-shrink: 0;
  padding: 15rpx 0;
  color: var(--amber);
  font-size: var(--font-xs);
  font-weight: 700;
  text-align: right;
}
.rule-category-items { border-top: 1rpx solid var(--border); padding: 0 22rpx; }
.rule-browser-row {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid var(--border);
  box-sizing: border-box;
}
.rule-browser-row:last-child { border-bottom: 0; }
.rule-browser-copy { min-width: 0; flex: 1; }
.rule-browser-label {
  display: -webkit-box;
  overflow: hidden;
  color: var(--text);
  font-size: var(--font-sm);
  font-weight: 750;
  line-height: 1.4;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.rule-browser-meta,
.rule-browser-hint {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: var(--font-xs);
  line-height: 1.4;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rule-browser-hint { max-width: 430rpx; opacity: .86; }
.rule-browser-value { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; }
.rule-row-arrow { color: var(--muted); font-size: var(--font-md); }
.family-agreement-heading { display: flex; align-items: center; gap: 14rpx; min-width: 0; }
.family-agreement-icon {
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 19rpx;
  background: var(--amber-light);
}
.family-agreement-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  min-height: 76rpx;
  padding: 18rpx 2rpx;
  border-bottom: 1rpx solid var(--border);
  box-sizing: border-box;
}
.family-agreement-row:last-child { border-bottom: 0; }
.family-agreement-no {
  flex: 0 0 46rpx;
  color: var(--amber);
  font-size: var(--font-xs);
  font-weight: 800;
  letter-spacing: 1rpx;
}
.family-agreement-text {
  min-width: 0;
  flex: 1;
  color: var(--text);
  font-size: var(--font-sm);
  line-height: 1.55;
  overflow-wrap: anywhere;
}
.rule-empty-state {
  padding: 70rpx 30rpx;
  border: 1rpx dashed var(--border);
  border-radius: var(--radius);
  background: var(--card);
  text-align: center;
}
.rule-empty-icon {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 18rpx;
  border-radius: 30rpx;
  background: var(--amber-light);
}
.rule-empty-title,
.rule-empty-copy { display: block; }
.rule-empty-title { color: var(--text); font-size: var(--font-md); font-weight: 800; }
.rule-empty-copy { margin-top: 8rpx; color: var(--muted); font-size: var(--font-xs); line-height: 1.6; }
.rule-empty-action { margin-top: 22rpx; }

/* 规则详情使用完全不透明的底部面板，避免原生组件穿透和误触关闭。 */
.rule-detail-overlay {
  position: fixed;
  inset: 0;
  z-index: 280;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  background: rgba(18,25,22,.58);
  box-sizing: border-box;
}
.rule-detail-panel {
  width: 100%;
  max-height: 84vh;
  padding: 16rpx 30rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background: #FFFDF9;
  box-shadow: 0 -22rpx 70rpx rgba(15,39,31,.24);
  box-sizing: border-box;
  overflow-y: auto;
}
.theme-mint .rule-detail-panel { background: #FBFFFD; }
.rule-detail-handle { width: 76rpx; height: 8rpx; margin: 0 auto 22rpx; border-radius: 999rpx; background: var(--border); }
.rule-detail-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.rule-detail-type { display: block; margin-bottom: 7rpx; font-size: var(--font-xs); font-weight: 800; }
.rule-detail-type.reward { color: var(--green); }
.rule-detail-type.punish { color: var(--red); }
.rule-detail-type.special { color: var(--amber); }
.rule-detail-title {
  display: block;
  color: var(--text);
  font-size: var(--font-lg);
  font-weight: 850;
  line-height: 1.3;
  overflow-wrap: anywhere;
}
.rule-detail-close {
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: -8rpx -12rpx 0 0;
  color: var(--muted);
  font-size: var(--font-score-6d);
  line-height: 1;
}
.rule-detail-score-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 26rpx 0 14rpx;
  padding: 22rpx;
  border-radius: var(--radius-sm);
}
.rule-detail-score-card.reward { background: rgba(92,153,25,.09); }
.rule-detail-score-card.punish { background: rgba(226,75,74,.08); }
.rule-detail-score { flex-shrink: 0; font-size: var(--font-xl); font-weight: 900; white-space: nowrap; }
.rule-detail-score-card.reward .rule-detail-score { color: var(--green); }
.rule-detail-score-card.punish .rule-detail-score { color: var(--red); }
.rule-detail-fields { border: 1rpx solid var(--border); border-radius: var(--radius-sm); overflow: hidden; }
.rule-detail-field {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  padding: 20rpx 22rpx;
  border-bottom: 1rpx solid var(--border);
}
.rule-detail-field:last-child { border-bottom: 0; }
.rule-detail-field-label { color: var(--muted); font-size: var(--font-sm); }
.rule-detail-field-value { color: var(--text); font-size: var(--font-sm); font-weight: 700; text-align: right; overflow-wrap: anywhere; }
.rule-detail-explain,
.rule-detail-agreement {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: var(--radius-sm);
  background: var(--amber-light);
}
.rule-detail-explain-title { display: block; margin-bottom: 8rpx; color: var(--amber); font-size: var(--font-sm); font-weight: 800; }
.rule-detail-explain-copy { display: block; color: var(--text); font-size: var(--font-sm); line-height: 1.65; overflow-wrap: anywhere; }
.rule-detail-remedy { display: block; margin-top: 16rpx; color: var(--muted); font-size: var(--font-xs); line-height: 1.6; }
.rule-detail-agreement { display: flex; align-items: flex-start; gap: 18rpx; margin: 28rpx 0; color: var(--text); font-size: var(--font-md); line-height: 1.7; overflow-wrap: anywhere; }
.rule-detail-agreement-icon { flex: 0 0 66rpx; }
.rule-detail-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.rule-detail-actions .rule-detail-done,
.rule-detail-actions .rule-detail-score-action { flex: 1; width: auto; min-width: 0; margin: 0; font-size: var(--font-sm); }
.rule-detail-score-action { box-shadow: 0 12rpx 28rpx rgba(45,155,122,.20); }

@keyframes loadingSpin { to { transform: rotate(360deg); } }

.section-hint {
  text-align: center;
  color: var(--muted);
  padding: 80rpx 0;
  font-size: var(--font-md);
  display: block;
}

/* ===== Footer ===== */
.footer {
  text-align: center;
  padding: 32rpx 24rpx 40rpx;
  font-size: var(--font-xs);
  color: var(--muted);
}
.jar-lid {
  width: 72%;
  height: 42rpx;
  margin-top: 18rpx;
  padding: 0 16rpx;
  border: 5rpx solid var(--jar-accent);
  border-radius: 25rpx 25rpx 14rpx 14rpx;
  background: linear-gradient(180deg, #fff 0%, rgba(255,255,255,.92) 42%, var(--jar-soft) 43%, var(--jar-accent) 100%);
  box-shadow: inset 0 3rpx 0 rgba(255,255,255,.95), 0 8rpx 16rpx rgba(61,48,42,.16);
  overflow: hidden;
  position: relative;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: space-evenly;
  box-sizing: border-box;
}
.jar-lid-gloss {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  top: 4rpx;
  height: 10rpx;
  border-radius: 10rpx;
  background: rgba(255,255,255,.72);
}
.jar-lid-ridge {
  width: 3rpx;
  height: 13rpx;
  margin-top: 17rpx;
  border-radius: 2rpx;
  background: rgba(255,255,255,.46);
  z-index: 1;
}
.jar-neck {
  width: 56%;
  height: 29rpx;
  margin-top: -2rpx;
  border-left: 6rpx solid var(--jar-accent);
  border-right: 6rpx solid var(--jar-accent);
  background: linear-gradient(90deg, rgba(255,255,255,.7), rgba(255,255,255,.96), rgba(255,255,255,.68));
  box-shadow: inset 0 4rpx 10rpx rgba(255,255,255,.8);
  box-sizing: border-box;
}
.jar-body {
  position: relative;
  width: 100%;
  flex: 1;
  border: 6rpx solid var(--jar-accent);
  border-radius: 50rpx 50rpx 72rpx 72rpx;
  box-sizing: border-box;
  overflow: hidden;
  padding: 27rpx 12rpx 17rpx;
  background: radial-gradient(circle at 82% 17%, rgba(255,255,255,.92), transparent 25%), linear-gradient(145deg, rgba(255,255,255,.98), var(--jar-soft) 53%, rgba(255,255,255,.74));
  backdrop-filter: blur(16rpx);
  box-shadow: inset 13rpx 11rpx 0 rgba(255,255,255,.52), inset -10rpx -14rpx 30rpx rgba(255,255,255,.26), 0 5rpx 0 rgba(255,255,255,.56), 0 12rpx 22rpx rgba(45,64,58,.1);
  display: flex;
  flex-direction: column;
}
.jar-glass-rim {
  position: absolute;
  inset: 8rpx;
  border: 2rpx solid rgba(255,255,255,.72);
  border-radius: 40rpx 40rpx 62rpx 62rpx;
  z-index: 1;
  pointer-events: none;
}
.jar-body-star {
  background: linear-gradient(160deg, #293B58, #142238 72%, #0D1728) !important;
  box-shadow: inset 12rpx 10rpx 0 rgba(255,255,255,.12), inset -8rpx -10rpx 30rpx rgba(5,10,20,.28), 0 0 24rpx rgba(243,184,91,.16);
}
.jar-body-star .jar-label { background: rgba(12,24,40,.66); box-shadow: inset 0 1rpx 0 rgba(255,255,255,.12); }
.jar-body-star .card-name, .jar-body-star .card-hint, .jar-body-star .jar-label-eyebrow { color: rgba(255,255,255,.88); }
.jar-body-star .candy { opacity: .72; box-shadow: 0 0 18rpx rgba(255,193,94,.75); }
.jar-body-star .score-wrap { color: #FFC36A !important; text-shadow: 0 0 18rpx rgba(255,176,66,.44); }
.jar-body-star .jar-family-watermark { opacity: .1; }
.jar-family-watermark {
  position: absolute;
  left: 50%;
  top: 57%;
  transform: translate(-50%, -50%);
  opacity: .15;
  z-index: 1;
  pointer-events: none;
}
.jar-shine {
  position: absolute;
  left: 15rpx;
  top: 35rpx;
  width: 10rpx;
  height: 148rpx;
  border-radius: 10rpx;
  background: linear-gradient(rgba(255,255,255,.82), rgba(255,255,255,.08));
  z-index: 2;
}
.candy { position: absolute; opacity: .3; animation: candyFloat 3.6s ease-in-out infinite; z-index: 2; }
.candy-a { width: 32rpx; height: 32rpx; border-radius: 50%; right: 20rpx; bottom: 20rpx; background: var(--jar-accent); }
.candy-b { width: 24rpx; height: 24rpx; border-radius: 50%; left: 27rpx; bottom: 25rpx; background: #F6B83F; animation-delay: .7s; }
.candy-c { width: 19rpx; height: 19rpx; border-radius: 50%; border: 4rpx solid var(--jar-accent); right: 28rpx; top: 77rpx; animation-delay: 1.2s; }
.candy-d { width: 16rpx; height: 16rpx; border-radius: 50%; left: 48rpx; bottom: 18rpx; background: #6AB68F; animation-delay: 1.7s; }

.home-footer {
  padding: 34rpx 0 8rpx;
  text-align: center;
  color: var(--muted);
  font-size: var(--font-xs);
  opacity: .78;
}

/* ===== 首次登录图解 ===== */
.login-guide-overlay {
  position: fixed;
  inset: 0;
  z-index: 260;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
  background: rgba(8,24,20,.5);
  animation: fadeIn .2s ease-out;
}
.login-guide-panel {
  width: 100%;
  padding: 18rpx 30rpx 42rpx;
  box-sizing: border-box;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background: var(--card);
  color: var(--text);
  box-shadow: 0 -20rpx 60rpx rgba(8,45,34,.22);
  animation: slideUp .3s cubic-bezier(.2,.9,.2,1);
}
.guide-handle { width: 72rpx; height: 8rpx; margin: 0 auto 24rpx; border-radius: 999rpx; background: var(--border); }
.guide-title { display: block; text-align: center; font-size: var(--font-lg); font-weight: 800; }
.guide-subtitle { display: block; text-align: center; margin: 8rpx 0 28rpx; font-size: var(--font-xs); color: var(--muted); }
.guide-steps { padding: 4rpx 6rpx 26rpx; }
.guide-step { display: grid; grid-template-columns: 44rpx 74rpx 1fr; align-items: center; gap: 14rpx; }
.guide-step-no { width: 44rpx; height: 44rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: var(--amber); font-size: var(--font-xs); font-weight: 800; }
.guide-step-icon { width: 68rpx; height: 68rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; color: var(--amber-dark); background: var(--amber-light); font-size: var(--font-sm); font-weight: 800; }
.guide-step-title { display: block; font-size: var(--font-md); font-weight: 700; }
.guide-step-copy { display: block; margin-top: 3rpx; font-size: var(--font-xs); color: var(--muted); }
.guide-step-line { width: 2rpx; height: 28rpx; margin: 5rpx 0 5rpx 21rpx; background: var(--border); }
.guide-done { width: 100%; }
