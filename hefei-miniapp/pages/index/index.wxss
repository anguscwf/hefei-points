/* pages/index/index.wxss */
.page-container {
  padding: 24rpx 28rpx;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* ===== Header ===== */
.header {
  background: var(--amber);
  color: #fff;
  padding: 28rpx 32rpx;
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
  text-align: center;
  position: relative;
  box-shadow: 0 4rpx 24rpx rgba(184,105,50,0.2);
}
.header-title {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  display: block;
}
.header-status {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 4rpx;
  display: block;
}
.refresh-btn {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255,255,255,0.15);
  border: none;
  color: #fff;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 登录栏 ===== */
.login-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.logout-bar {
  background: var(--card);
  border-radius: var(--radius);
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.user-picker {
  flex: 1;
}
.picker-display {
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  background: var(--card);
}
.pwd-input {
  flex: 2;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
}
.logged-user {
  flex: 1;
  font-size: 28rpx;
  color: var(--muted);
}

/* ===== 积分卡片 ===== */
.score-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.score-card {
  flex: 1;
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 24rpx 20rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  border: 8rpx solid transparent;
  display: flex;
  flex-direction: column;
  min-height: 360rpx;
}
.score-card:active {
  transform: scale(0.97);
}
.card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.card-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #fff;
  flex-shrink: 0;
}
.card-name {
  font-size: 28rpx;
  font-weight: 600;
}
.score-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  flex: 1;
  margin: -8rpx 0;
  overflow: hidden;
}
.score-sign {
  font-size: 96rpx;
  font-weight: 800;
  margin-right: 4rpx;
}
.score-num {
  font-size: 180rpx;
  font-weight: 900;
  line-height: 0.9;
  letter-spacing: -6rpx;
}
.card-hint {
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
}

/* ===== Tab 切换 ===== */
.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.tab {
  flex: 1;
  padding: 22rpx 16rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--border);
  background: var(--card);
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
}
.tab.active {
  background: var(--amber);
  color: #fff;
  border-color: var(--amber);
  box-shadow: 0 4rpx 16rpx rgba(184,105,50,0.25);
}

.tab-content {
  animation: fadeIn 0.25s ease-out;
}

/* ===== 积分记录 ===== */
.history-item {
  background: var(--card);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 6rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.04);
  border-left: 6rpx solid #ccc;
}
.history-item:active {
  background: #fafafa;
  transform: scale(0.99);
}
.hi-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.hi-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  color: var(--muted);
  font-size: 22rpx;
}
.hi-kid {
  font-weight: 600;
  font-size: 26rpx;
  white-space: nowrap;
}
.hi-amount {
  font-weight: 700;
  font-size: 28rpx;
  white-space: nowrap;
}
.hi-amount.plus { color: var(--green); }
.hi-amount.minus { color: var(--red); }
.hi-reason {
  font-size: 26rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hi-note {
  font-size: 24rpx;
  color: var(--amber);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 200rpx;
  flex-shrink: 1;
}
.hi-op, .hi-time {
  white-space: nowrap;
}

/* ===== 规则 ===== */
.rule-cat-card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.punish-card {
  border-left: 6rpx solid #FFCDD2;
}
.rule-cat-card:first-child {
  border-left: 6rpx solid #C8E6C9;
}
.rule-cat-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.rule-item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 8rpx;
  background: #F9FBF7;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
}
.punish-card .rule-item-row {
  background: #FFF5F5;
}
.rule-item-label {
  font-weight: 500;
}
.rule-item-range {
  font-weight: 600;
}
.special-rules-card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  border-left: 6rpx solid var(--amber);
}
.special-item {
  font-size: 26rpx;
  padding: 6rpx 0;
  display: block;
}

.section-hint {
  text-align: center;
  color: var(--muted);
  padding: 80rpx 0;
  font-size: 28rpx;
  display: block;
}

/* ===== Footer ===== */
.footer {
  text-align: center;
  padding: 32rpx 24rpx 40rpx;
  font-size: 22rpx;
  color: var(--muted);
}
