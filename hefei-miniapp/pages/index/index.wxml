<!-- pages/index/index.wxml - 首页 -->
<page-meta page-style="{{themePageStyle}}"></page-meta>
<view class="page-container {{themeClass}}">

  <!-- 头部 -->
  <view class="header" wx:if="{{isLoggedIn}}">
    <view class="hero-glow hero-glow-a"></view>
    <view class="hero-glow hero-glow-b"></view>
    <view class="brand-row">
      <view class="brand-mark"><ui-icon name="brand" size="70" theme="{{iconTheme}}" variant="white" /></view>
      <view class="brand-copy">
        <text class="brand-title">糖罐积分</text>
        <text class="brand-subtitle">把每一次好习惯，装进成长糖罐</text>
      </view>
    </view>
    <text class="header-status">{{loginStatusText}}</text>
    <view class="refresh-btn" bindtap="onRefresh"><ui-icon name="refresh" size="38" theme="{{iconTheme}}" variant="white" /></view>
  </view>

  <!-- 未登录欢迎页 -->
  <view class="welcome-card" wx:if="{{!isLoggedIn}}">
    <view class="welcome-orbit welcome-orbit-a"></view>
    <view class="welcome-orbit welcome-orbit-b"></view>
    <view class="welcome-logo"><ui-icon name="brand" size="112" theme="{{iconTheme}}" /></view>
    <text class="welcome-title">糖罐育儿积分</text>
    <text class="welcome-subtitle">把每一次好习惯，装进成长糖罐</text>
    <button class="btn btn-primary wx-login-btn" loading="{{wxLoginLoading}}" disabled="{{wxLoginLoading}}" bindtap="onWxLogin">{{wxLoginLoading ? '登录中...' : '微信一键登录'}}</button>
    <text class="login-guide-link" bindtap="onOpenLoginGuide">第一次使用？查看 3 步登录说明</text>
  </view>

  <!-- 未登录不从服务端枚举家庭成员 -->
  <view class="loading-bar" wx:if="{{!isLoggedIn && !loadingUsers && userOptions.length === 0}}">
    <view class="perm-hint">
      <text>用户列表受保护，请输入家庭中已有的用户ID登录</text>
    </view>
  </view>

  <!-- 备用账号登录 -->
  <view class="backup-login" wx:if="{{!isLoggedIn && !loadingUsers && pickerKey}}">
    <view class="login-divider"><view></view><text>输入家庭账号备用登录</text><view></view></view>
    <view class="bind-status" wx:if="{{showBind}}">
      <text>正在绑定微信账号，请输入已有家庭用户ID和密码</text>
      <text class="bind-cancel" bindtap="onCancelWxBind">取消绑定</text>
    </view>
    <view class="login-bar">
      <picker wx:if="{{userOptions.length > 0}}" class="user-picker" range="{{userOptions}}" range-key="name" value="{{selectedUserIdx}}" bindchange="onSelectUser">
        <view class="picker-display">{{selectedUserName || '选择用户'}}</view>
      </picker>
      <input wx:else class="uid-input" placeholder="用户ID" value="{{manualUserId}}" bindinput="onUserIdInput" />
      <input class="pwd-input" password="{{true}}" placeholder="密码" value="{{password}}" bindinput="onPwdInput" />
      <button class="btn btn-outline btn-sm" bindtap="onLogin">登录</button>
    </view>
  </view>

  <!-- 已登录栏 -->
  <view class="login-bar logout-bar" wx:if="{{isLoggedIn}}">
    <text class="logged-hint">已登录</text>
    <button class="btn btn-outline btn-sm icon-only-btn" wx:if="{{isAdmin}}" bindtap="goAdmin" aria-label="管理后台"><ui-icon name="settings" size="34" theme="{{iconTheme}}" /></button>
    <button class="btn btn-outline btn-sm" bindtap="onLogout">退出</button>
  </view>

  <!-- 权限提示 -->
  <view class="perm-hint" wx:if="{{!isLoggedIn}}">登录后可查看积分</view>

  <!-- 积分卡片 -->
  <view class="kid-switcher" wx:if="{{isLoggedIn && kidSwitcher.length > 0}}">
    <view class="kid-switch-item {{item.selected ? 'selected' : ''}}" wx:for="{{kidSwitcher}}" wx:key="id"
      bindtap="onKidViewTap" data-kid="{{item.id}}">
      <view class="kid-switch-avatar" style="border-color: {{item.borderColor || 'var(--amber)'}};">
        <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" />
        <ui-icon wx:else name="{{item.icon}}" size="46" theme="{{iconTheme}}" />
      </view>
      <text class="kid-switch-name">{{item.name}}</text>
    </view>
  </view>

  <view class="score-grid" wx:if="{{isLoggedIn && childCards.length > 0}}">
    <view class="score-card {{isChild ? 'score-card-child' : ''}}" wx:for="{{childCards}}" wx:key="id"
      style="--jar-accent: {{item.borderColor}}; --jar-soft: {{item.softColor}};"
      bindtap="onCardTap" data-kid="{{item.id}}" data-name="{{item.name}}">
      <view class="jar-lid">
        <view class="jar-lid-gloss"></view>
        <view class="jar-lid-ridge"></view>
        <view class="jar-lid-ridge"></view>
        <view class="jar-lid-ridge"></view>
      </view>
      <view class="jar-neck"></view>
      <view class="jar-body {{item.skin === 'star' ? 'jar-body-star' : ''}}">
        <view class="jar-glass-rim"></view>
        <view class="jar-shine"></view>
        <view class="jar-family-watermark"><ui-icon name="family-heart" size="132" variant="white" /></view>
        <view class="candy candy-a"></view>
        <view class="candy candy-b"></view>
        <view class="candy candy-c"></view>
        <view class="candy candy-d"></view>
        <view class="jar-label">
          <view class="kid-card-avatar">
            <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" />
            <ui-icon wx:else name="{{item.icon}}" size="42" theme="{{iconTheme}}" />
          </view>
          <view class="jar-label-copy">
            <text class="jar-label-eyebrow">成长糖罐</text>
            <text class="card-name">{{item.name}}</text>
          </view>
        </view>
        <view class="score-wrap" style="color: {{item.borderColor}};">
          <view class="score-number-core {{item.scoreSize}}">
            <text class="score-sign">{{item.sign}}</text>
            <text class="score-num {{item.scoreSize}}">{{item.absScore}}</text>
          </view>
        </view>
        <text class="card-hint">{{isChild ? '我的每一步都在发光' : '轻点记录成长'}}</text>
      </view>
    </view>
  </view>

  <view class="family-note" wx:if="{{isLoggedIn}}">
    <view class="family-note-icon"><ui-icon name="family-heart" size="48" theme="{{iconTheme}}" /></view>
    <view><text class="family-note-title">一起把小事做成好习惯</text><text class="family-note-sub">看见努力，及时鼓励，成长自然发生</text></view>
  </view>

  <!-- Tab 切换 -->
  <view class="tabs" wx:if="{{isLoggedIn}}">
    <view class="tab {{activeTab === 'history' ? 'active' : ''}}" bindtap="switchTab" data-tab="history">积分记录</view>
    <view class="tab {{activeTab === 'rules' ? 'active' : ''}}" bindtap="switchTab" data-tab="rules">规则</view>
    <view class="tab tab-link" bindtap="switchTab" data-tab="report">成长报表 ↗</view>
  </view>

  <!-- Tab 内容 -->
  <view class="tab-content" wx:if="{{isLoggedIn}}">

    <!-- 积分记录 -->
    <view wx:if="{{activeTab === 'history'}}">
      <view wx:if="{{historyList.length === 0}}" class="empty">暂无记录</view>
      <view wx:else>
        <view class="history-item" wx:for="{{historyList}}" wx:key="id"
          style="border-left-color: {{item.kidColor}};"
          bindtap="onRecordTap" data-index="{{index}}">
          <view class="hi-left">
            <text class="hi-kid" style="color: {{item.kidColor}};">{{item.kidName}}</text>
            <text class="hi-amount {{item.isPlus ? 'plus' : 'minus'}}">{{item.amountText}}</text>
            <text class="hi-reason">{{item.reason}}</text>
            <text class="hi-note" wx:if="{{item.note}}">{{item.note}}</text>
          </view>
          <view class="hi-right">
            <text class="hi-op">{{item.operator}}</text>
            <text class="hi-time">{{item.time}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 规则中心：浏览和理解规则，不在这里直接记分 -->
    <view wx:if="{{activeTab === 'rules'}}" class="rule-center">
      <view wx:if="{{!rulesData}}" class="empty">正在整理家庭规则...</view>
      <block wx:else>
        <view class="rule-center-hero">
          <view class="rule-center-hero-icon"><ui-icon name="clipboard" size="44" theme="{{iconTheme}}" /></view>
          <view class="rule-center-hero-copy">
            <text class="rule-center-title">{{ruleCenterTitle}}</text>
            <text class="rule-center-intro">{{ruleCenterIntro}}</text>
            <text class="rule-center-count">{{ruleSummary.categoryCount}} 个分类 · {{ruleSummary.ruleCount}} 条积分规则 · {{ruleSummary.specialCount}} 条约定</text>
          </view>
        </view>

        <view class="rule-search-box">
          <view class="rule-search-glyph"></view>
          <input class="rule-search-input" value="{{ruleQuery}}" placeholder="搜索规则、分类、单位或说明" confirm-type="search" bindinput="onRuleQueryInput" />
          <text wx:if="{{ruleQuery}}" class="rule-search-clear" bindtap="onRuleQueryClear">清除</text>
        </view>

        <scroll-view class="rule-filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="rule-filter-row">
            <view wx:for="{{ruleFilterOptions}}" wx:key="value"
              class="rule-filter-chip {{ruleFilter === item.value ? 'active' : ''}}"
              data-filter="{{item.value}}" bindtap="onRuleFilterTap">{{item.label}}</view>
          </view>
        </scroll-view>

        <view wx:if="{{!ruleSummary.isEmpty}}" class="rule-center-guide">
          <ui-icon name="spark" size="28" theme="{{iconTheme}}" />
          <text>{{isChild ? '通常分值是每次大约会得到或扣掉的糖果' : '通常分值用于轻点记录；长按记分规则可按范围调整'}}</text>
        </view>

        <view wx:if="{{!ruleQuery && ruleFilter === 'all' && frequentRules.length}}" class="frequent-rules-card">
          <view class="rule-block-heading">
            <view>
              <text class="rule-block-title">最近常用</text>
              <text class="rule-block-sub">轻点查看详情，记分仍从孩子糖罐进入</text>
            </view>
            <text class="rule-block-badge">优先展示</text>
          </view>
          <view class="frequent-rule-grid">
            <view wx:for="{{frequentRules}}" wx:key="key" class="frequent-rule-item {{item.isReward ? 'reward' : 'punish'}}"
              data-item="{{item}}" bindtap="onFrequentRuleTap">
              <view class="frequent-rule-copy">
                <text class="frequent-rule-label">{{item.label}}</text>
                <text class="frequent-rule-category">{{item.category}}</text>
              </view>
              <text class="rule-default-pill {{item.isReward ? 'reward' : 'punish'}}">{{item.defaultText}}</text>
            </view>
          </view>
        </view>

        <view wx:for="{{ruleBrowser.categories}}" wx:key="key" wx:for-item="cat"
          class="rule-category-card {{cat.isReward ? 'reward' : 'punish'}}">
          <view class="rule-category-head" data-key="{{cat.key}}" bindtap="onRuleCategoryTap">
            <view class="rule-category-icon {{cat.isReward ? 'reward' : 'punish'}}">
              <ui-icon name="{{cat.isReward ? 'trend-up' : 'trend-down'}}" size="32" theme="{{iconTheme}}" />
            </view>
            <view class="rule-category-copy">
              <view class="rule-category-title-row">
                <text class="rule-category-title">{{cat.category}}</text>
                <text class="rule-category-count">{{cat.totalCount}} 项</text>
              </view>
              <text wx:if="{{!cat.expanded && cat.preview}}" class="rule-category-preview">{{cat.preview}}</text>
            </view>
            <text wx:if="{{ruleQuery}}" class="rule-category-toggle">匹配 {{cat.count}} 项</text>
            <text wx:else class="rule-category-toggle">{{cat.expanded ? '收起 ︿' : '展开 ﹀'}}</text>
          </view>
          <view wx:if="{{cat.expanded}}" class="rule-category-items">
            <view wx:for="{{cat.items}}" wx:key="key" wx:for-item="rule" class="rule-browser-row"
              data-item="{{rule}}" bindtap="onRuleItemTap">
              <view class="rule-browser-copy">
                <text class="rule-browser-label">{{rule.label}}</text>
                <text class="rule-browser-meta">{{rule.unit || '按每次记录'}} · {{rule.rangeDisplay}}{{rule.min !== null && rule.max !== null ? ' 分' : ''}}</text>
                <text wx:if="{{rule.hint}}" class="rule-browser-hint">{{rule.hint}}</text>
              </view>
              <view class="rule-browser-value">
                <text class="rule-default-pill {{rule.isReward ? 'reward' : 'punish'}}">{{rule.defaultText}}</text>
                <text class="rule-row-arrow">›</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{ruleBrowser.specials.length}}" class="family-agreement-card">
          <view class="rule-block-heading">
            <view class="family-agreement-heading">
              <view class="family-agreement-icon"><ui-icon name="family-heart" size="34" theme="{{iconTheme}}" /></view>
              <view><text class="rule-block-title">我们家的约定</text><text class="rule-block-sub">全家一起记住、一起做到</text></view>
            </view>
            <text class="rule-block-badge">{{ruleBrowser.specials.length}} 条</text>
          </view>
          <view wx:for="{{ruleBrowser.specials}}" wx:key="key" class="family-agreement-row"
            data-item="{{item}}" bindtap="onSpecialRuleTap">
            <text class="family-agreement-no">{{item.numberText}}</text>
            <text class="family-agreement-text">{{item.text}}</text>
            <text class="rule-row-arrow">›</text>
          </view>
        </view>

        <view wx:if="{{ruleBrowser.resultCount === 0}}" class="rule-empty-state">
          <view class="rule-empty-icon"><ui-icon name="clipboard" size="50" theme="{{iconTheme}}" /></view>
          <text class="rule-empty-title">{{ruleQuery ? '没有找到这条规则' : '家庭规则还在准备中'}}</text>
          <text class="rule-empty-copy">{{ruleQuery ? '试试搜索分类、单位或更短的关键词' : (isChild ? '可以请家长一起商量成长约定' : '管理员可到管理后台添加第一条规则')}}</text>
          <button wx:if="{{ruleQuery}}" class="btn btn-outline btn-xs rule-empty-action" bindtap="onRuleQueryClear">清除搜索</button>
        </view>
      </block>
    </view>

  </view>

  <view class="home-footer">
    <text>v{{version}} · 粤ICP备2026059273号-1X</text>
  </view>

</view>

<!-- 规则详情：家长可带着当前规则直接进入记分确认，孩子只阅读规则。 -->
<view class="rule-detail-overlay {{themeClass}}" wx:if="{{ruleDetailVisible}}" catchtouchmove="stopBubble">
  <scroll-view class="rule-detail-panel" scroll-y enhanced show-scrollbar="{{false}}" catchtap="stopBubble">
    <view class="rule-detail-handle"></view>
    <view class="rule-detail-head">
      <view>
        <text class="rule-detail-type {{ruleDetail.toneClass}}">{{ruleDetail.typeText}}</text>
        <text class="rule-detail-title">{{ruleDetail.label}}</text>
      </view>
      <view class="rule-detail-close" bindtap="onRuleDetailClose">×</view>
    </view>

    <view wx:if="{{ruleDetail.isSpecial}}" class="rule-detail-agreement">
      <view class="rule-detail-agreement-icon"><ui-icon name="family-heart" size="54" theme="{{iconTheme}}" /></view>
      <text>{{ruleDetail.hintText}}</text>
    </view>

    <block wx:else>
      <view class="rule-detail-score-card {{ruleDetail.toneClass}}">
        <text class="rule-detail-field-label">{{ruleDetail.defaultCaption}}</text>
        <text class="rule-detail-score">{{ruleDetail.defaultText}}</text>
      </view>
      <view class="rule-detail-fields">
        <view class="rule-detail-field">
          <text class="rule-detail-field-label">{{ruleDetail.rangeCaption}}</text>
          <text class="rule-detail-field-value">{{ruleDetail.rangeText}}</text>
        </view>
        <view class="rule-detail-field">
          <text class="rule-detail-field-label">计算方式</text>
          <text class="rule-detail-field-value">{{ruleDetail.unitText}}</text>
        </view>
      </view>
      <view class="rule-detail-explain">
        <text class="rule-detail-explain-title">{{ruleDetail.hintCaption}}</text>
        <text class="rule-detail-explain-copy">{{ruleDetail.hintText}}</text>
      </view>
      <text wx:if="{{ruleDetail.toneClass === 'punish'}}" class="rule-detail-remedy">先理解发生了什么，再一起想想下次怎样做得更好。</text>
    </block>

    <view class="rule-detail-actions">
      <button class="btn {{ruleDetail.canScore && isParent && !isChild ? 'btn-outline' : 'btn-primary'}} rule-detail-done" bindtap="onRuleDetailClose">
        {{ruleDetail.canScore && isParent && !isChild ? '稍后再说' : '我明白了'}}
      </button>
      <button wx:if="{{ruleDetail.canScore && isParent && !isChild}}"
        class="btn btn-primary rule-detail-score-action" bindtap="onRuleDetailScore">按这条规则记分</button>
    </view>
  </scroll-view>
</view>

<!-- 首次登录图解 -->
<view class="login-guide-overlay" wx:if="{{showLoginGuide}}" bindtap="onCloseLoginGuide">
  <view class="login-guide-panel" catchtap="stopBubble">
    <view class="guide-handle"></view>
    <text class="guide-title">第一次登录，只要 3 步</text>
    <text class="guide-subtitle">不用记密码，下次打开会自动登录</text>
    <view class="guide-steps">
      <view class="guide-step">
        <text class="guide-step-no">1</text><text class="guide-step-icon">微信</text>
        <view><text class="guide-step-title">点微信登录</text><text class="guide-step-copy">从首页绿色主按钮开始</text></view>
      </view>
      <view class="guide-step-line"></view>
      <view class="guide-step">
        <text class="guide-step-no">2</text><text class="guide-step-icon">✓</text>
        <view><text class="guide-step-title">完成微信登录</text><text class="guide-step-copy">这一步只建立登录状态</text></view>
      </view>
      <view class="guide-step-line"></view>
      <view class="guide-step">
        <text class="guide-step-no">3</text><text class="guide-step-icon">糖</text>
        <view><text class="guide-step-title">自动进入糖罐</text><text class="guide-step-copy">积分与记录立即同步</text></view>
      </view>
    </view>
    <button class="btn btn-primary guide-done" bindtap="onCloseLoginGuide">知道了，开始使用</button>
  </view>
</view>

<!-- 底部操作弹窗 -->
<action-sheet
  show="{{sheetVisible}}"
  theme="{{iconTheme}}"
  kidName="{{sheetKidName}}"
  kidPoints="{{sheetKidPoints}}"
  rewardRules="{{rulesData.reward}}"
  punishRules="{{rulesData.punish}}"
  frequentRules="{{frequentRules}}"
  bind:close="onSheetClose"
  bind:quick="onRuleQuick"
  bind:adjust="onRuleSelect"
  bind:manual="onManualInput"
/>

<!-- 数字调节弹窗 -->
<number-modal
  show="{{numModalVisible}}"
  title="{{numTitle}}"
  desc="{{numDesc}}"
  value="{{numValue}}"
  min="{{numItem ? numItem.min : -999}}"
  max="{{numItem ? numItem.max : 999}}"
  bind:close="onNumModalClose"
  bind:confirm="onNumConfirm"
  bind:change="onNumChange"
/>

<!-- Toast -->
<toast-msg message="{{toastMessage}}" show="{{toastVisible}}" />
