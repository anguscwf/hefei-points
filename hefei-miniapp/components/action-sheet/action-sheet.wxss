/* components/action-sheet/action-sheet.wxss */
.overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.35);
  z-index: 99;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}
.overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.sheet {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: var(--card);
  border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx;
  box-shadow: 0 -8rpx 48rpx rgba(0,0,0,0.12);
  z-index: 100;
  max-height: 70vh;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}
.sheet.show {
  transform: translateY(0);
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  display: block;
  margin-bottom: 20rpx;
}

.sheet-close {
  position: absolute;
  right: 32rpx;
  top: 28rpx;
  background: none;
  border: none;
  font-size: 40rpx;
  color: var(--muted);
  padding: 0;
  line-height: 1;
}

.sheet-scroll {
  max-height: 55vh;
}

.cat-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--muted);
  margin: 20rpx 0 12rpx;
  padding-left: 8rpx;
  display: block;
}

.cat-subtitle {
  font-size: 22rpx;
  color: var(--muted);
  margin: 8rpx 0 4rpx 16rpx;
  display: block;
}

.rule-item {
  display: block;
  width: 100%;
  padding: 28rpx;
  text-align: left;
  border-radius: var(--radius-sm);
  font-size: 30rpx;
  margin-bottom: 12rpx;
  background: #f8f8f8;
}
.rule-item:active {
  background: #eee;
  transform: scale(0.98);
}
.rule-item.reward {
  border-left: 6rpx solid var(--green);
}
.rule-item.punish {
  border-left: 6rpx solid var(--red);
}
.ri-label {
  font-weight: 500;
  display: block;
}
.ri-hint {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 4rpx;
  display: block;
}

.manual-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
  padding: 16rpx 0;
}
.manual-amt {
  width: 140rpx;
  padding: 20rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
}
.manual-reason {
  flex: 1;
  padding: 20rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
}
