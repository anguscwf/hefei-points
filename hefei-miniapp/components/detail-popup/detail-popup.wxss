/* components/detail-popup/detail-popup.wxss */
.detail-popup {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s;
}
.detail-popup.show {
  opacity: 1;
  pointer-events: auto;
}
.dp-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
}
.dp-box {
  position: relative;
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 40rpx 48rpx;
  width: 640rpx;
  max-width: 90vw;
  transform: scale(0.9);
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}
.detail-popup.show .dp-box {
  transform: scale(1);
}
.dp-close {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  background: none;
  border: none;
  font-size: 40rpx;
  color: var(--muted);
  padding: 0;
  line-height: 1;
}
.dp-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  display: block;
  margin-bottom: 24rpx;
}
.dp-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}
.dp-label {
  color: var(--muted);
}
.dp-val {
  font-weight: 500;
}
.dp-note-section {
  margin-top: 28rpx;
}
.dp-note-label {
  font-size: 26rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
  display: block;
}
.dp-note-current {
  font-size: 28rpx;
  padding: 20rpx;
  background: var(--amber-light);
  border-radius: var(--radius-sm);
  color: var(--amber);
  min-height: 40rpx;
  word-break: break-all;
}
.dp-note-current.empty {
  color: var(--muted);
  font-style: italic;
  background: #f5f5f5;
}
.dp-note-input {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.dp-note-input input {
  flex: 1;
  padding: 20rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
}
.dp-note-input button {
  padding: 20rpx 32rpx;
  border-radius: var(--radius-sm);
  border: none;
  background: var(--amber);
  color: #fff;
  font-size: 28rpx;
}
