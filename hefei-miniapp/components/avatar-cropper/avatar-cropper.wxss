.cropper-overlay {
  position: fixed;
  inset: 0;
  z-index: 2000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  background: rgba(13, 31, 27, 0.64);
  box-sizing: border-box;
  backdrop-filter: blur(12rpx);
}

.cropper-panel {
  width: 100%;
  max-width: 700rpx;
  padding: 34rpx;
  border: 1rpx solid rgba(255,255,255,.72);
  border-radius: 42rpx;
  background: var(--card);
  box-shadow: 0 30rpx 80rpx rgba(5, 30, 24, .28);
  box-sizing: border-box;
  animation: cropper-rise .32s cubic-bezier(.2, .9, .28, 1.18);
}

@keyframes cropper-rise {
  from { opacity: 0; transform: translateY(80rpx) scale(.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.cropper-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.cropper-title { display: block; color: var(--text); font-size: var(--font-lg); font-weight: 800; }
.cropper-subtitle { display: block; margin-top: 7rpx; color: var(--muted); font-size: var(--font-xs); }
.cropper-close {
  width: 58rpx;
  height: 58rpx;
  min-height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: var(--soft);
  color: var(--muted);
  font-size: var(--font-lg);
  line-height: 54rpx;
}
.cropper-close::after, .crop-btn::after { border: 0; }

.shape-tabs {
  display: flex;
  gap: 10rpx;
  margin: 26rpx 0 20rpx;
  padding: 7rpx;
  border-radius: 24rpx;
  background: var(--soft);
}
.shape-tab {
  flex: 1;
  padding: 14rpx 18rpx;
  border-radius: 19rpx;
  color: var(--muted);
  font-size: var(--font-sm);
  text-align: center;
  transition: all .22s ease;
}
.shape-tab.active { background: var(--card); color: var(--accent-dark); font-weight: 700; box-shadow: var(--shadow-sm); }

.crop-stage {
  position: relative;
  width: 620rpx;
  height: 620rpx;
  max-width: 100%;
  max-height: 620rpx;
  margin: 0 auto;
  overflow: hidden;
  border-radius: 30rpx;
  background: #14241F;
  touch-action: none;
}
.crop-image { position: absolute; left: 0; top: 0; transform-origin: 0 0; will-change: transform; }
.crop-loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,.72); font-size: var(--font-sm); }
.crop-mask {
  position: absolute;
  inset: 0;
  pointer-events: none;
  box-shadow: inset 0 0 0 999rpx rgba(4, 18, 15, .52);
  border: 4rpx solid rgba(255,255,255,.94);
  box-sizing: border-box;
}
.crop-mask.circle { border-radius: 50%; }
.crop-mask.square { border-radius: 28rpx; }
.crop-grid { position: absolute; inset: 0; pointer-events: none; opacity: .34; }
.crop-grid.circle { border-radius: 50%; overflow: hidden; }
.crop-grid.square { border-radius: 28rpx; overflow: hidden; }
.crop-grid view { position: absolute; display: block; background: #fff; }
.crop-grid view:nth-child(1), .crop-grid view:nth-child(2) { top: 0; bottom: 0; width: 1rpx; }
.crop-grid view:nth-child(1) { left: 33.333%; }
.crop-grid view:nth-child(2) { left: 66.666%; }
.crop-grid view:nth-child(3), .crop-grid view:nth-child(4) { left: 0; right: 0; height: 1rpx; }
.crop-grid view:nth-child(3) { top: 33.333%; }
.crop-grid view:nth-child(4) { top: 66.666%; }

.zoom-row { display: flex; align-items: center; gap: 8rpx; margin: 22rpx 0 20rpx; }
.zoom-symbol { width: 44rpx; color: var(--muted); font-size: var(--font-md); text-align: center; }
.zoom-slider { flex: 1; margin: 0; }
.cropper-actions { display: flex; gap: 16rpx; }
.crop-btn { flex: 1; min-height: 86rpx; margin: 0; border-radius: 25rpx; font-size: var(--font-md); font-weight: 700; line-height: 86rpx; }
.crop-cancel { background: var(--soft); color: var(--text); }
.crop-apply { background: var(--gradient-accent); color: #fff; box-shadow: 0 12rpx 24rpx var(--glow); }
.crop-apply[disabled] { opacity: .55; }
.crop-output-canvas { position: fixed; left: -9999px; top: -9999px; width: 512px; height: 512px; }

@media (max-height: 760px) {
  .crop-stage { width: 500rpx; height: 500rpx; }
  .cropper-panel { padding: 26rpx; }
}
