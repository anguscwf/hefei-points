<!-- components/number-modal/number-modal.wxml -->
<view class="modal-overlay" wx:if="{{show}}" bindtap="onClose" style="animation: fadeIn 0.2s ease;">
  <view class="modal-box" catchtap="" style="animation: scaleIn 0.2s cubic-bezier(0.16, 1, 0.3, 1); position: relative;">
    <view class="modal-close" bindtap="onClose" style="position: absolute; top: 20rpx; right: 20rpx;">✕</view>
    <text class="modal-title">{{title}}</text>
    <text class="num-desc">{{desc}}</text>
    <view class="num-row">
      <button class="num-btn" bindtouchstart="onLongMinusStart" bindtouchend="onLongEnd" bindtap="onMinus">−</button>
      <text class="num-display {{value >= 0 ? 'positive' : 'negative'}}">{{valueText}}</text>
      <button class="num-btn" bindtouchstart="onLongPlusStart" bindtouchend="onLongEnd" bindtap="onPlus">+</button>
    </view>
    <view class="dp-note-input" style="margin-top: 16rpx;">
      <input type="text" placeholder="备注（选填）" value="{{note}}" bindinput="onNoteInput" />
    </view>
    <view class="num-actions">
      <button class="btn btn-outline" bindtap="onClose">取消</button>
      <button class="btn btn-primary" bindtap="onConfirm">确定</button>
    </view>
  </view>
</view>
