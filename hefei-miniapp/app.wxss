/* 赫菲积分管理 全局样式 · 琥珀暖色调 */
page {
  --blue: #4A90D9;
  --blue-light: #E8F2FC;
  --blue-dark: #2E6EB5;
  --pink: #E87DA8;
  --pink-light: #FDE8F0;
  --pink-dark: #C55078;
  --amber: #B86932;
  --amber-light: #FFF5EC;
  --bg: #F9F6F1;
  --card: #fff;
  --text: #2C2C2A;
  --muted: #999;
  --border: #EBE5DD;
  --green: #5C9919;
  --red: #E24B4A;
  --radius-sm: 8px;
  --radius: 12px;
  --radius-lg: 16px;

  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

/* 按钮 */
.btn {
  padding: 16rpx 28rpx;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.btn:active { opacity: 0.8; transform: scale(0.96); }
.btn-primary {
  background: var(--amber);
  color: #fff;
}
.btn-outline {
  background: var(--card);
  color: var(--amber);
  border: 2rpx solid var(--amber);
}
.btn-sm { padding: 12rpx 20rpx; font-size: 26rpx; }
.btn-xs { padding: 8rpx 16rpx; font-size: 24rpx; }
.btn-blue { background: var(--blue); color: #fff; }
.btn-pink { background: var(--pink); color: #fff; }

/* 文本辅助 */
.text-xs { font-size: 22rpx; }
.text-sm { font-size: 26rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-muted { color: var(--muted); }
.text-primary { color: var(--amber); }
.text-success { color: var(--green); }
.text-danger { color: var(--red); }
.font-semibold { font-weight: 600; }
.font-bold { font-weight: 700; }
.text-center { text-align: center; }

/* 布局 */
.flex { display: flex; }
.flex-1 { flex: 1; }
.flex-col { flex-direction: column; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.items-center { align-items: center; }
.gap-sm { gap: 12rpx; }
.mt-sm { margin-top: 12rpx; }
.mt-md { margin-top: 24rpx; }
.mb-sm { margin-bottom: 12rpx; }
.mb-md { margin-bottom: 24rpx; }
.ml-sm { margin-left: 12rpx; }
.px-sm { padding-left: 16rpx; padding-right: 16rpx; }

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #ccc;
  font-size: 28rpx;
}

/* 提示 */
.perm-hint {
  background: var(--card);
  border-radius: var(--radius);
  padding: 24rpx;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border);
}
